LR_SHXrich_SolidOut_T   as Temperature      (description:"Outlet temperature of LR_SHXrich (C)");
LR_SHXrich_Q            as EnthFlow         (description:"Heat duty of LR_SHXrich (GJ/hr)");
LR_SHXlean_SolidIn_T    as Temperature      (description:"Inlet temperature of LR_SHXlean (C)");
LR_SHXlean_SolidOut_T   as Temperature      (description:"Outlet temperature of LR_SHXlean (C)");
LR_SHXlean_Q            as EnthFlow         (description:"Heat duty of LR_SHXlean (GJ/hr)");
CW_SHXlean_SolidIn_T    as Temperature      (description:"Inlet temperature of CW_SHXlean (C)");
CW_SHXlean_SolidOut_T   as Temperature      (description:"Outlet temperature of CW_SHXlean (C)");
CW_SHXlean_Q            as EnthFlow         (description:"Heat duty of CW_SHXlean (GJ/hr)");
BFBadsB_Tse             as Temperature      (description:"Temperature of BFBadsB (C)");
BFBadsB_Q               as EnthFlow         (description:"Heat duty of BFBadsB (GJ/hr)");
BFBadsM_Tse             as Temperature      (description:"Temperature of BFBadsM (C)");
