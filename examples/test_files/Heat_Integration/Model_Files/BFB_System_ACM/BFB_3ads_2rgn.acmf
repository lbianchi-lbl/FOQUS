call Port.direction(0)
call Port.name("SolidOut")
call Port.at(0.250446,-0.349626)
call Port.IOtype(1)
call Port.direction(270)
call Port.name("UniversalIN")
call Port.at(-0.399576,0.00128865)
call Port.direction(0)
call Port.name("UniversalOUT")
call Port.at(0.400007,0.00128865)
call Port.IOtype(1)
call Port.direction(0)
end sub



endtext

SHX2_T0_I0 as SHX2_T0;
SystemData : Text
<FORMLIST DEFAULTFORM="AllVariables">
</FORMLIST>
EndText;

//SYSTEM SECTION END
END
Model Split

// Gas Stream split unit

Feed            as Input MainPort;
Out1            as Output MainPort;
Out2            as Output MainPort;

Feed.F = Out1.F + Out2.F;

Feed.P = Out1.P;
Feed.T = Out1.T;
Feed.z = Out1.z;

Feed.P = Out2.P;
Feed.T = Out2.T;
Feed.z = Out2.z;

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
SystemData : Text
<FORMLIST DEFAULTFORM="AllVariables">
</FORMLIST>
EndText;

//SYSTEM SECTION END
End
Model Injector

Steam           AS Input MainPort;
GasIn           AS Input MainPort;
GasOut          AS Output MainPort;

GasOut.P = GasIn.P;

GasOut.F = GasIn.F + Steam.F;

GasOut.z*GasOut.F = GasIn.z*GasIn.F + Steam.z*Steam.F;

GasOut.h*GasOut.F = GasIn.h*GasIn.F + Steam.h*Steam.F;

Call(GasIn.h) = pEnth_Mol_Vap (GasIn.T, GasIn.P, GasIn.z);
Call(GasOut.h) = pEnth_Mol_Vap (GasOut.T, GasOut.P, GasOut.z);
Call(Steam.T) = pDewT (Steam.P, Steam.z);
Call(Steam.h) = pEnth_Mol_Vap (Steam.T, Steam.P, Steam.z);

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
SystemData : Text
<FORMLIST DEFAULTFORM="AllVariables">
</FORMLIST>
EndText;

//SYSTEM SECTION END
End
SystemData : Text
globaldatasection
EndText;
