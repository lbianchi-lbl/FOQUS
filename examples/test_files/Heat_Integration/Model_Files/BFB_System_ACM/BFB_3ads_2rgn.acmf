BFBadsT_Tse             as Temperature      (description:"Temperature of BFBadsT (C)");
BFBadsT_Q               as EnthFlow         (description:"Heat duty of BFBadsT (GJ/hr)");
BFBrgnB_Tse             as Temperature      (description:"Temperature of BFBrgnB (C)");
BFBrgnB_Q               as EnthFlow         (description:"Heat duty of BFBrgnB (GJ/hr)");
BFBrgnT_Tse             as Temperature      (description:"Temperature of BFBrgnT (C)");
BFBrgnT_Q               as EnthFlow         (description:"Heat duty of BFBrgnT (GJ/hr)");

        GHXfg_GasIn_T = GHXfg.GasIn.T;
        GHXfg_GasOut_T  = GHXfg.GasOut.T;
        GHXfg_Q = adsN*GHXfg.Q;
        GHXcmp_GasIn_T = GHXcmp.GasIn.T;
        GHXcmp_GasOut_T  = GHXcmp.GasOut.T;
        GHXcmp_Q = rgnN*GHXcmp.Q;
        LR_SHXrich_SolidIn_T = LR_SHXrich.SolidIn.T;
        LR_SHXrich_SolidOut_T = LR_SHXrich.SolidOut.T;
        LR_SHXrich_Q = rgnN*LR_SHXrich.Q;
        LR_SHXlean_SolidIn_T = LR_SHXlean.SolidIn.T;
        LR_SHXlean_SolidOut_T = LR_SHXlean.SolidOut.T;
        LR_SHXlean_Q = rgnN*LR_SHXlean.Q;
        CW_SHXlean_SolidIn_T = CW_SHXlean.SolidIn.T;
        CW_SHXlean_SolidOut_T = CW_SHXlean.SolidOut.T;
        CW_SHXlean_Q = rgnN*CW_SHXlean.Q;
        BFBadsB_Tse = BFBadsB.Tse.Value(99);
        BFBadsB_Q = adsN*BFBadsB.Q;
        BFBadsM_Tse = BFBadsM.Tse.Value(99);
        BFBadsM_Q = adsN*BFBadsM.Q;
        BFBadsT_Tse = BFBadsT.Tse.Value(99);
        BFBadsT_Q = adsN*BFBadsT.Q;
        BFBrgnB_Tse = BFBrgnB.Tse.Value(99);
        BFBrgnB_Q = rgnN*BFBrgnB.Q;
