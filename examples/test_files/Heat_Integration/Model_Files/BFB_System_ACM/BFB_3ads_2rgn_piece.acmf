TYPE IPsolve ROLE "SCRIPT" TEXT ' Solution script for the BFBads with sequential initialization procedure.

' The script solves the model in incremental steps of complexity by using
' initialization procedure selectors (described below). The selectors are
' switched from an 'Initial' state that selects a set of simplified model
' equations to 'Rigorous' which selects a set of more accurate equations.

' This script is meant to be used on an empty unit once enough variables
' have been specified to satisfy the degrees of freedom.
' For a more complete understanding, please refer to the BFBads model syntax.

' Juan Morinelly, January 2013

' IPselector              Description
' ---------------------------------------------------------
' IPselectA               Bubble Region Material Balance
' IPselectB               Hydrodynamics Model
' IPselectC               Solids Material Balance
' IPselectD               Emulsion Region Energy Balance
' IPselectE               Cloud-Wake Region Energy Balance
' IPselectF               Bubble Region Energy Balance

IPselectA.value = "Initial"
IPselectB.value = "Initial"
IPselectC.value = "Initial"
IPselectD.value = "Initial"
IPselectE.value = "Initial"
IPselectF.value = "Initial"
Simulation.Run(True)

IPselectA.value = "Rigorous"
Simulation.Run(True)

IPselectB.value = "Rigorous"
Simulation.Run(True)

IPselectC.value = "Rigorous"
Simulation.Run(True)

IPselectD.value = "Rigorous"
Simulation.Run(True)

IPselectE.value = "Rigorous"
Simulation.Run(True)

IPselectF.value = "Rigorous"
Simulation.Run(True)

ENDTEXT

//SYSTEM SECTION END
END
Model GHX
/*
Simple Heat Exchanger Model for Cooling a Gas Stream
Adapted by Juan Morinelly (2011) from previous model by Hosoo Kim (2011)
Last updated: Juan Morinelly (Jun. 2011)
*/
// ======================================================================================================================
// Heat Exchange Parameters

Q                       as EnthFlow           (description:"Required heat (GJ/hr)");
A_exch                  as Area               (description:"Required area (m^2)");
LMTD                    as Temperature        (description:"Log mean temperature difference (K)");
U                       as Heat_Trans_Coeff   (description:"Overall heat transfer coefficient (kW/m^2/K)", 0.17, Fixed);
dP                      as Press_Drop         (description:"Pressure drop gas side (bar)", 0.01, Fixed);
dPhx                    as Press_Drop         (description:"Pressure drop HX fluid side (bar)", 0.01, Fixed);

// ----------------------------------------------------------------------------------------------------------------------
// Flash Parameters (at outlet conditions)

VF                      as VapFraction        (description:"Gas side outlet vapor fraction (kmol/kmol)");
rhov                    as Dens_Mol_Vap       (description:"Gas side outlet molar density of vapor phase (kmol/m3)");
rhol                    as Dens_Mol_Liq       (description:"Gas side outlet molar density of liquid phase (kmol/m3)");
x(ComponentList)        as MoleFraction       (description:"Gas side outlet liquid phase mole fraction (kmol/kmol)");
y(ComponentList)        as MoleFraction       (description:"Gas side outlet vapor phase mole fraction (kmol/kmol)");
hl                      as Enth_Mol_Liq       (description:"Gas side outlet liquid phase molar enthalpy (GJ/kmol)");
hv                      as Enth_Mol_Vap       (description:"Gas side outlet vapor phase molar enthalpy (GJ/kmol)");

// ----------------------------------------------------------------------------------------------------------------------
// HX Flash Properties

HXIn_VF                 as VapFraction         (description:"HX fluid inlet vapor fraction (kmol/kmol)");
HXIn_x(componentlist)   as Molefraction        (description:"HX fluid inlet liquid phase mole fraction (kmol/kmol)");
HXIn_y(componentlist)   as Molefraction        (description:"HX fluid inlet vapor phase mole fraction (kmol/kmol)");
HXIn_hl                 as Enth_Mol_Liq        (description:"HX fluid inlet liquid phase molar enthalpy (GJ/kmol)");
HXIn_hv                 as Enth_Mol_Vap        (description:"HX fluid inlet vapor phase molar enthalpy (GJ/kmol)");
HXOut_VF                as VapFraction         (description:"HX fluid outlet vapor fraction (kmol/kmol)");
HXOut_x(componentlist)  as Molefraction        (description:"HX fluid outlet liquid phase mole fraction (kmol/kmol)");
HXOut_y(componentlist)  as Molefraction        (description:"HX fluid outlet vapor phase mole fraction (kmol/kmol)");
HXOut_hl                as Enth_Mol_Liq        (description:"HX fluid outlet liquid phase molar enthalpy (GJ/kmol)");
HXOut_hv                as Enth_Mol_Vap        (description:"HX fluid outlet vapor phase molar enthalpy (GJ/kmol)");

// ----------------------------------------------------------------------------------------------------------------------
// Intermediate Gas Stream Properties

N_Piece                 as IntegerParameter    (description:"Number of heat integration pieces", value:5);

Int_In_T([1:N_Piece])    as Temperature         (description:"Intermediate gas side inlet temperature (C)");
Int_Out_T([1:N_Piece])   as Temperature         (description:"Intermediate gas side outlet temperature (C)");
Int_Out_P([1:N_Piece])   as Pressure            (description:"Intermediate gas side outlet pressure (C)");
Qint([1:N_Piece])        as EnthFlow            (description:"Intermediate heat load (GJ/hr)");

Int_Out_VF([1:N_Piece])                as VapFraction         (description:"Intermediate gas side outlet vapor fraction (kmol/kmol)");
Int_Out_x(componentlist)([1:N_Piece])  as Molefraction        (description:"Intermediate gas side outlet liquid phase mole fraction (kmol/kmol)");
Int_Out_y(componentlist)([1:N_Piece])  as Molefraction        (description:"Intermediate gas side outlet vapor phase mole fraction (kmol/kmol)");
Int_Out_hl([1:N_Piece])                as Enth_Mol_Liq        (description:"Intermediate gas side outlet liquid phase molar enthalpy (GJ/kmol)");
Int_Out_hv([1:N_Piece])                as Enth_Mol_Vap        (description:"Intermediate gas side outlet vapor phase molar enthalpy (GJ/kmol)");
Int_Out_h([1:N_Piece])                 as Enth_Mol            (description:"Intermediate gas side outlet molar enthalpy (GJ/kmol)");

// ---------------------------------------------------------------------------------------------------------------------- 
// Ports

GasIn                   as Input              MainPort;
GasOut                  as Output             MainPort;
LiqOut                  as Output             MainPort;

HXIn                    as Input              MainPort;
HXOut                   as Output             MainPort;

// ======================================================================================================================
// Model Equations

// ---------------------------------------------------------------------------------------------------------------------- 
        // Gas Side Calculations
        Call(y, x, VF, hv, hl) = pFlash(GasOut.T, GasOut.P, GasIn.z);
        Call(rhov) = pDens_Mol_Vap(GasOut.T, GasOut.P, x);
        Call(rhol) = pDens_Mol_Liq(GasOut.T, GasOut.P, y);
        Call(GasIn.h) = pEnth_Mol_Vap(GasIn.T, GasIn.P, GasIn.z);

        // HX Fluid Side Calculations
        Call (HXIn_y, HXIn_x, HXIn_VF, HXIn_hv, HXIn_hl) = pFlash (HxIn.T, HXIn.P, HXIn.z(componentlist));
        Call (HXOut_y, HXOut_x, HXOut_VF, HXOut_hv, HXOut_hl) = pFlash (HXOut.T, HXOut.P, HXOut.z(componentlist));
        HXIn.h = HXIn_hv*HXIn_VF + HXIn_hl*(1-HXIn_VF);

        // Heat Exchange Equations (Energy balance neglects kinetic and potential energy contributions)
        Call(LMTD) = pLMTD(GasIn.T, HXIn.T, GasOut.T, HXOut.T, "Countercurrent");
        Q = U*A_exch*LMTD*3600*1E-6; // 3600 s, 1E-6 GJ -> 1 hr, 1 kJ
        Q = GasIn.F*(GasOut.h - GasIn.h);
        -Q = HXIn.F*(HXOut.h - HXIn.h);

        // GasOut Outlet Stream Properties
        GasOut.F = GasIn.F*VF;
        GasOut.h = VF*hv + (1-VF)*hl;
        GasOut.P = GasIn.P - dP;
        GasOut.z = y;

        // HXOut Outlet Stream Properties
        HXOut.F = HXIn.F;
        HXOut.h = HXOut_hv*HXOut_VF + HXOut_hl*(1-HXOut_VF);
        HXOut.P = HXIn.P - dPhx;
        HXOut.z = HXIn.z;

        // Condensate Stream Properties
        LiqOut.F = GasIn.F*(1-VF);
        LiqOut.P = GasOut.P;
        LiqOut.T = GasOut.T;
        LiqOut.z = x;

        // Intermediate Gas Stream Properties
        Int_In_T(1) = GasIn.T;
        Int_Out_T(N_Piece) = GasOut.T;
        For i In [2:N_Piece] Do
            Int_In_T(i) = Int_Out_T(i-1);
        EndFor

        Int_Out_P(1) = GasIn.P - dP/N_Piece;
        For i In [2:N_Piece] Do
            Int_Out_P(i) = Int_Out_P(i-1) - dP/N_Piece;
        EndFor

        For i In [1:N_Piece-1] Do
            Call(Int_Out_y(componentlist)(i), Int_Out_x(componentlist)(i), Int_Out_VF(i), Int_Out_hv(i), Int_Out_hl(i)) = pFlash(Int_Out_T(i), Int_Out_P(i), GasIn.z(componentlist));
            Int_Out_h(i) = Int_Out_VF(i)*Int_Out_hv(i) + (1 - Int_Out_VF(i))*Int_Out_hl(i);
        EndFor
        
        Int_Out_VF(N_Piece) = VF;               
        Int_Out_x(componentlist)(N_Piece) = x(componentlist);  
        Int_Out_y(componentlist)(N_Piece) = y(componentlist); 
        Int_Out_hl(N_Piece) = hl;               
        Int_Out_hv(N_Piece) = hv;               
        Int_Out_h(N_Piece) = GasOut.h;

        Qint(1) = GasIn.F*(Int_Out_h(1) - GasIn.h);
        For i In [2:N_Piece] Do
            Qint(i) = GasIn.F*(Int_Out_h(i) - Int_Out_h(i-1));
        EndFor
        For i In [1:N_Piece-1] Do
            Int_Out_T(i+1) - Int_Out_T(i) = (GasOut.T - GasIn.T)/N_Piece;
            // Qint(i) = Q/N_Piece;
        EndFor

// ======================================================================================================================

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
