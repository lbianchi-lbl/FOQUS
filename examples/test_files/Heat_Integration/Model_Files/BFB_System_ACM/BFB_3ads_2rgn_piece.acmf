FLOWSHEET
  BFBadsB as BFB;
  BFBadsM as BFB;
  CMPads as PolyComp;
  BFBrgnT as BFB;
  BFBrgnB as BFB;
  GHXfg as GHX;
  LR_SHXrich as SHX;
  LR_SHXlean as SHX;
  CW_SHXlean as SHX2;
  SPTR as Split;
  CMPrgn as PolyComp;
  SINJ as Injector;
  GHXcmp as GHX;
  BFBadsT as BFB;
  GasIn_adsB as Connection;
  GasIn_adsM as Connection;
  SolidOut_adsB as Connection;
  SolidIn_adsM as Connection;
  SolidIn_adsB as Connection;
  GasIn_adsT as Connection;
  Flue_Gas1 as Connection;
  GasIn_rgnT as Connection;
  SolidIn_rgnB as Connection;
  SolidIn_rgnT as Connection;
  SolidOut_rgnB as Connection;
  GasOut_rgnT as Connection;
  GasIn_rgnB as Connection;
  Flue_Gas as Connection;
  SolidIn_rgn as Connection;
  SolidIn_ads0 as Connection;
  SolidIn_ads1 as Connection;
  Recycle_rgn0 as Connection;
  Recycle_rgn1 as Connection;
  GasOut_rgn0 as Connection;
  TO_COMP as Connection;
  TO_STACK as Connection;
  SolidIn_adsT as Connection;
  Connect CMPads.GasOut and BFBadsB.GasIn with GasIn_adsB;
  Connect BFBadsB.GasOut and BFBadsM.GasIn with GasIn_adsM;
  Connect BFBadsB.SolidOut with SolidOut_adsB;
  Connect BFBadsT.SolidOut and BFBadsM.SolidIn with SolidIn_adsM;
  Connect BFBadsM.SolidOut and BFBadsB.SolidIn with SolidIn_adsB;
  Connect BFBadsM.GasOut and BFBadsT.GasIn with GasIn_adsT;
  Connect GHXfg.GasOut and CMPads.GasIn with Flue_Gas1;
  Connect BFBrgnB.GasOut and BFBrgnT.GasIn with GasIn_rgnT;
  Connect BFBrgnT.SolidOut and BFBrgnB.SolidIn with SolidIn_rgnB;
  Connect LR_SHXrich.SolidOut and BFBrgnT.SolidIn with SolidIn_rgnT;
  Connect BFBrgnB.SolidOut and LR_SHXlean.SolidIn with SolidOut_rgnB;
  Connect BFBrgnT.GasOut and SPTR.Feed with GasOut_rgnT;
  Connect BFBrgnB.GasIn with GasIn_rgnB;
  Connect GHXfg.GasIn with Flue_Gas;
  Connect LR_SHXrich.SolidIn with SolidIn_rgn;
  Connect LR_SHXlean.SolidOut and CW_SHXlean.SolidIn with SolidIn_ads0;
  Connect CW_SHXlean.SolidOut with SolidIn_ads1;
  Connect SPTR.Out1 and CMPrgn.GasIn with Recycle_rgn0;
  Connect CMPrgn.GasOut and SINJ.GasIn with Recycle_rgn1;
  Connect SPTR.Out2 and GHXcmp.GasIn with GasOut_rgn0;
  Connect GHXcmp.GasOut with TO_COMP;
  Connect BFBadsT.GasOut with TO_STACK;
  Connect BFBadsT.SolidIn with SolidIn_adsT;

CONSTRAINTS
/*
Solid sorbent two-stage adsorption, two-stage regeneration process for CO2 capture using CCSI BFB Model v6.0
Juan Morinelly (2013)
*/
// =============================================================================================================
// Declare Flowsheet Variables

removalCO2              as NoType           (description:"Adsorption CO2 removal fraction");
removalH2O              as NoType           (description:"Adsorption H2O removal fraction");
lean_loading            as Loading          (description:"Sorbent loading at adsorption feed (mol/kg solid)");
rich_loading            as Loading          (description:"Sorbent loading at regeneration feed (mol/kg solid)");
delta_loading           as Loading          (description:"Process sorbent work loading (mol/kg solid)");

dPads                   as Press_Drop       (description:"Adsorption pressure drop (bar)");
dPrgn                   as Press_Drop       (description:"Regeneration pressure drop (bar)");

FGIn                    as Flow_Mol         (description:"Flue gas flowrate (kmol/hr)", 100377, spec:Fixed);

adsDt                   as Length           (description:"Adsorption units diameter (m)");
rgnDt                   as Length           (description:"Regeneration units diameter (m)");
adsdx                   as Length           (description:"Adsorption units HX tubes diameter (m)");
rgndx                   as Length           (description:"Regeneration units HX tubes diameter (m)");
adslhx                  as Length           (description:"Adsorption units HX tubes spacing (m)");
rgnlhx                  as Length           (description:"Regeneration units HX tubes spacing (m)");
adsN                    as NoType           (description:"Number of parallel adsorption trains");
rgnN                    as NoType           (description:"Number of parallel regeneration trains");

rgnSF                   as fraction         (description:"Regeneration section recirculation gas split fraction");

A1                      as notype           (description:"Arrhenius Constant for Water Physisorption (mol/m^3.Pa.K.s)");
A2                      as notype           (description:"Arrhenius Constant for Bicarbonate Formation (1/Pa.K.s)");
A3                      as notype           (description:"Arrhenius Constant for Carbamate Formation (1/Pa^m1.K.s)");
E1                      as notype           (description:"Activation Energy for Water Physisorption (J/mol)");
E2                      as notype           (description:"Activation Energy for Bicarbonate Formation (J/mol)");
E3                      as notype           (description:"Activation Energy for Carbamate Formation (J/mol)");
dH1                     as notype           (description:"Heat of Reaction for Water Physisorption (J/mol)");
dH2                     as notype           (description:"Heat of Reaction for Bicarbonate Formation (J/mol)");
dH3                     as notype           (description:"Heat of Reaction for Carbamate Formation (J/mol)");
dS1                     as notype           (description:"Reaction Entropy for Water Physisorption (J/mol.K)");
dS2                     as notype           (description:"Reaction Entropy for Bicarbonate Formation (J/mol.K)");
dS3                     as notype           (description:"Reaction Entropy for Carbamate Formation (J/mol.K)");
nv                      as notype           (description:"Amine Loading of Sorbent (mol/m^3)");

dp                      as length           (description:"Particle Diameter (m)");
emf                     as fraction         (description:"Bed Voidage at Minimum Fluidisation");
fw                      as notype           (description:"Wake to Bubble Region Volume Ratio");
hw                      as notype           (description:"Heat Exchanger Tube Wall Heat Transfer Coefficient (kJ/m^2.K.s)");
Kd                      as notype           (description:"Gas Phase Bulk Flow Coefficient (m^3/s)");
nor                     as notype           (description:"Number of Orifices per Square Meter in Distributor Plate (m^-2)");

UQ_A1                   as coefficient      (description:"A1 UQ coefficient", spec:Fixed);
UQ_A2                   as coefficient      (description:"A2 UQ coefficient", spec:Fixed);
UQ_A3                   as coefficient      (description:"A3 UQ coefficient", spec:Fixed);
UQ_E1                   as coefficient      (description:"E1 UQ coefficient", spec:Fixed);
UQ_E2                   as coefficient      (description:"E2 UQ coefficient", spec:Fixed);
UQ_E3                   as coefficient      (description:"E3 UQ coefficient", spec:Fixed);
UQ_dH1                  as coefficient      (description:"dH1 UQ coefficient", spec:Fixed);
UQ_dH2                  as coefficient      (description:"dH2 UQ coefficient", spec:Fixed);
UQ_dH3                  as coefficient      (description:"dH3 UQ coefficient", spec:Fixed);
UQ_dS1                  as coefficient      (description:"dS1 UQ coefficient", spec:Fixed);
UQ_dS2                  as coefficient      (description:"dS2 UQ coefficient", spec:Fixed);
UQ_dS3                  as coefficient      (description:"dS3 UQ coefficient", spec:Fixed);
UQ_nv                   as coefficient      (description:"nv UQ coefficient", spec:Fixed);

UQ_dp                   as coefficient      (description:"dp UQ coefficient", spec:Fixed);
UQ_emf                  as coefficient      (description:"emf UQ coefficient", spec:Fixed);
UQ_fw                   as coefficient      (description:"fw UQ coefficient", spec:Fixed);
UQ_hw                   as coefficient      (description:"hw UQ coefficient", spec:Fixed);
UQ_Kd                   as coefficient      (description:"Kd UQ coefficient", spec:Fixed);
UQ_nor                  as coefficient      (description:"nor UQ coefficient", spec:Fixed);

UQ_Kbc                  as coefficient      (description:"Kbc UQ coefficient", spec:Fixed);
UQ_Kce                  as coefficient      (description:"Kbe UQ coefficient", spec:Fixed);
UQ_Kcebs                as coefficient      (description:"Kcebs UQ coefficient", spec:Fixed);
UQ_Hbc                  as coefficient      (description:"Hbc UQ coefficient", spec:Fixed);
UQ_Hce                  as coefficient      (description:"Hce UQ coefficient", spec:Fixed);
UQ_hp                   as coefficient      (description:"hw UQ coefficient", spec:Fixed);
UQ_hl                   as coefficient      (description:"hw UQ coefficient", spec:Fixed);
UQ_hd                   as coefficient      (description:"hw UQ coefficient", spec:Fixed);

Ele_tot                 as Power            (description:"Total electricity consumption (MW)");
Q_tot                   as EnthFlow         (description:"Total heat consumption (GJ/hr)");
Inj_MP                  as Flow_Mol         (description:"MP steam injection rate (kmol/hr)");

// =============================================================================================================
// Flowsheet Equations

// -------------------------------------------------------------------------------------------------------------
// Process

        // Equations to Satisfy DOF
        Call(BFBadsB.GasIn.h) = pEnth_Mol_Vap(BFBadsB.GasIn.T,BFBadsB.GasIn.P,BFBadsB.GasIn.z);
        Call(BFBadsM.GasIn.h) = pEnth_Mol_Vap(BFBadsM.GasIn.T,BFBadsM.GasIn.P,BFBadsM.GasIn.z);
        Call(BFBadsT.GasIn.h) = pEnth_Mol_Vap(BFBadsT.GasIn.T,BFBadsT.GasIn.P,BFBadsT.GasIn.z);
        Call(BFBrgnT.GasIn.h) = pEnth_Mol_Vap(BFBrgnT.GasIn.T,BFBrgnT.GasIn.P,BFBrgnT.GasIn.z);
        Call(SPTR.Feed.h) = pEnth_Mol_Vap(SPTR.Feed.T,SPTR.Feed.P,SPTR.Feed.z);
        Call(CMPrgn.GasIn.h) = pEnth_Mol_Vap(CMPrgn.GasIn.T,CMPrgn.GasIn.P,CMPrgn.GasIn.z);

        // Adsorption Removal
        removalCO2 = 1 - BFBadsM.GasOut.F*BFBadsT.GasOut.z("CO2")/(BFBadsB.GasIn.F*BFBadsB.GasIn.z("CO2"));
        removalH2O = 1 - BFBadsM.GasOut.F*BFBadsT.GasOut.z("H2O")/(BFBadsB.GasIn.F*BFBadsB.GasIn.z("H2O"));

        // Sorbent Loading
        lean_loading = sigma(BFBadsT.SolidIn.w);
        rich_loading = sigma(BFBrgnT.SolidIn.w);
        delta_loading = rich_loading - lean_loading;
        
        // Overall Pressure Drop
        dPads = BFBadsB.GasIn.P - BFBadsT.GasOut.P;
        dPrgn = BFBrgnB.GasIn.P - BFBrgnT.GasOut.P;

        // Single Train Flue Gas Flowrate
        FGIn = adsN*GHXfg.GasIn.F;

        // Vessels Specification
        adsDt = BFBadsB.Dt;
        adsDt = BFBadsM.Dt;
        adsDt = BFBadsT.Dt;
        rgnDt = BFBrgnB.Dt;
        rgnDt = BFBrgnT.Dt;
        adsdx = BFBadsB.dx;
        adsdx = BFBadsM.dx;
        adsdx = BFBadsT.dx;
        rgndx = BFBrgnB.dx;
        rgndx = BFBrgnT.dx;
        adslhx = BFBadsB.lhx;
        adslhx = BFBadsM.lhx;
        adslhx = BFBadsT.lhx;
        rgnlhx = BFBrgnB.lhx;
        rgnlhx = BFBrgnT.lhx;

        // Cooling Water Integration for Adsorption Section
        BFBadsM.HXIn.T = BFBadsT.HXOut.T;
        BFBadsB.HXIn.T = BFBadsM.HXOut.T;

        // Lean-Rich Solid Heat Exchanger Equations
        LR_SHXlean.SolidOut.T = BFBadsB.SolidOut.T + 10; //Assumes 10 °C temperature approach
        LR_SHXrich.Q = -LR_SHXlean.Q;

        // Integration of Adsorption and Regeneration Sections
        LR_SHXrich.SolidIn.Fm = BFBadsB.SolidOut.Fm*adsN/rgnN;
        LR_SHXrich.SolidIn.T = BFBadsB.SolidOut.T;
        LR_SHXrich.SolidIn.w = BFBadsB.SolidOut.w;
        BFBadsT.SolidIn.T = CW_SHXlean.SolidOut.T;
        BFBadsT.SolidIn.w = CW_SHXlean.SolidOut.w;

        // Regeneration Gas Recirculation
        BFBrgnB.GasIn.F = SINJ.GasOut.F;
        BFBrgnB.GasIn.T = SINJ.GasOut.T;
        BFBrgnB.GasIn.z = SINJ.GasOut.z;
        CMPrgn.DischP = BFBrgnB.GasIn.P;
        rgnSF = SPTR.Out1.F/SPTR.Feed.F;

// -------------------------------------------------------------------------------------------------------------
// UQ

        // Bottom Adsorber Sorbent Model UQ Variables
        BFBadsB.A1 = UQ_A1*A1;
        BFBadsB.A2 = UQ_A2*A2;
        BFBadsB.A3 = UQ_A3*A3;
        BFBadsB.E1 = UQ_E1*E1;
        BFBadsB.E2 = UQ_E2*E2;
        BFBadsB.E3 = UQ_E3*E3;
        BFBadsB.dH1 = UQ_dH1*dH1;
        BFBadsB.dH2 = UQ_dH2*dH2;
        BFBadsB.dH3 = UQ_dH3*dH3;
        BFBadsB.dS1 = UQ_dS1*dS1;
        BFBadsB.dS2 = UQ_dS2*dS2;
        BFBadsB.dS3 = UQ_dS3*dS3;
        BFBadsB.nv = UQ_nv*nv;

        // Bottom Adsorber Fixed Value Variables
        BFBadsB.dp = UQ_dp*dp;
        BFBadsB.emf = UQ_emf*emf;
        BFBadsB.fw = UQ_fw*fw;
        BFBadsB.hw = UQ_hw*hw;
        BFBadsB.Kd = UQ_Kd*Kd;
        BFBadsB.nor = UQ_nor*nor;

        // Bottom Adsorber Correlated Variables
        BFBadsB.UQ_Kbc = UQ_Kbc;
        BFBadsB.UQ_Kce = UQ_Kce;
        BFBadsB.UQ_Kcebs = UQ_Kcebs;
        BFBadsB.UQ_Hbc = UQ_Hbc;
        BFBadsB.UQ_Hce = UQ_Hce;
        BFBadsB.UQ_hp = UQ_hp;
        BFBadsB.UQ_hl = UQ_hl;
        BFBadsB.UQ_hd = UQ_hd;

        // Middle Adsorber Sorbent Model UQ Variables
        BFBadsM.A1 = UQ_A1*A1;
        BFBadsM.A2 = UQ_A2*A2;
        BFBadsM.A3 = UQ_A3*A3;
        BFBadsM.E1 = UQ_E1*E1;
        BFBadsM.E2 = UQ_E2*E2;
        BFBadsM.E3 = UQ_E3*E3;
        BFBadsM.dH1 = UQ_dH1*dH1;
        BFBadsM.dH2 = UQ_dH2*dH2;
        BFBadsM.dH3 = UQ_dH3*dH3;
        BFBadsM.dS1 = UQ_dS1*dS1;
        BFBadsM.dS2 = UQ_dS2*dS2;
        BFBadsM.dS3 = UQ_dS3*dS3;
        BFBadsM.nv = UQ_nv*nv;

        // Middle Adsorber Fixed Value Variables
        BFBadsM.dp = UQ_dp*dp;
        BFBadsM.emf = UQ_emf*emf;
        BFBadsM.fw = UQ_fw*fw;
        BFBadsM.hw = UQ_hw*hw;
        BFBadsM.Kd = UQ_Kd*Kd;
        BFBadsM.nor = UQ_nor*nor;

        // Middle Adsorber Correlated Variables
        BFBadsM.UQ_Kbc = UQ_Kbc;
        BFBadsM.UQ_Kce = UQ_Kce;
        BFBadsM.UQ_Kcebs = UQ_Kcebs;
        BFBadsM.UQ_Hbc = UQ_Hbc;
        BFBadsM.UQ_Hce = UQ_Hce;
        BFBadsM.UQ_hp = UQ_hp;
        BFBadsM.UQ_hl = UQ_hl;
        BFBadsM.UQ_hd = UQ_hd;

        // Top Adsorber Sorbent Model UQ Variables
        BFBadsT.A1 = UQ_A1*A1;
        BFBadsT.A2 = UQ_A2*A2;
        BFBadsT.A3 = UQ_A3*A3;
        BFBadsT.E1 = UQ_E1*E1;
        BFBadsT.E2 = UQ_E2*E2;
        BFBadsT.E3 = UQ_E3*E3;
        BFBadsT.dH1 = UQ_dH1*dH1;
        BFBadsT.dH2 = UQ_dH2*dH2;
        BFBadsT.dH3 = UQ_dH3*dH3;
        BFBadsT.dS1 = UQ_dS1*dS1;
        BFBadsT.dS2 = UQ_dS2*dS2;
        BFBadsT.dS3 = UQ_dS3*dS3;
        BFBadsT.nv = UQ_nv*nv;

        // Top Adsorber Fixed Value Variables
        BFBadsT.dp = UQ_dp*dp;
        BFBadsT.emf = UQ_emf*emf;
        BFBadsT.fw = UQ_fw*fw;
        BFBadsT.hw = UQ_hw*hw;
        BFBadsT.Kd = UQ_Kd*Kd;
        BFBadsT.nor = UQ_nor*nor;

        // Top Adsorber Correlated Variables
        BFBadsT.UQ_Kbc = UQ_Kbc;
        BFBadsT.UQ_Kce = UQ_Kce;
        BFBadsT.UQ_Kcebs = UQ_Kcebs;
        BFBadsT.UQ_Hbc = UQ_Hbc;
        BFBadsT.UQ_Hce = UQ_Hce;
        BFBadsT.UQ_hp = UQ_hp;
        BFBadsT.UQ_hl = UQ_hl;
        BFBadsT.UQ_hd = UQ_hd;
        
        // Bottom Regenerator Sorbent Model UQ Variables
        BFBrgnB.A1 = UQ_A1*A1;
        BFBrgnB.A2 = UQ_A2*A2;
        BFBrgnB.A3 = UQ_A3*A3;
        BFBrgnB.E1 = UQ_E1*E1;
        BFBrgnB.E2 = UQ_E2*E2;
        BFBrgnB.E3 = UQ_E3*E3;
        BFBrgnB.dH1 = UQ_dH1*dH1;
        BFBrgnB.dH2 = UQ_dH2*dH2;
        BFBrgnB.dH3 = UQ_dH3*dH3;
        BFBrgnB.dS1 = UQ_dS1*dS1;
        BFBrgnB.dS2 = UQ_dS2*dS2;
        BFBrgnB.dS3 = UQ_dS3*dS3;
        BFBrgnB.nv = UQ_nv*nv;

        // Bottom Regenerator Fixed Value Variables
        BFBrgnB.dp = UQ_dp*dp;
        BFBrgnB.emf = UQ_emf*emf;
        BFBrgnB.fw = UQ_fw*fw;
        BFBrgnB.hw = UQ_hw*hw;
        BFBrgnB.Kd = UQ_Kd*Kd;
        BFBrgnB.nor = UQ_nor*nor;

        // Bottom Regenerator Correlated Variables
        BFBrgnB.UQ_Kbc = UQ_Kbc;
        BFBrgnB.UQ_Kce = UQ_Kce;
        BFBrgnB.UQ_Kcebs = UQ_Kcebs;
        BFBrgnB.UQ_Hbc = UQ_Hbc;
        BFBrgnB.UQ_Hce = UQ_Hce;
        BFBrgnB.UQ_hp = UQ_hp;
        BFBrgnB.UQ_hl = UQ_hl;
        BFBrgnB.UQ_hd = UQ_hd;

        // Top Regenerator Sorbent Model UQ Variables
        BFBrgnT.A1 = UQ_A1*A1;
        BFBrgnT.A2 = UQ_A2*A2;
        BFBrgnT.A3 = UQ_A3*A3;
        BFBrgnT.E1 = UQ_E1*E1;
        BFBrgnT.E2 = UQ_E2*E2;
        BFBrgnT.E3 = UQ_E3*E3;
        BFBrgnT.dH1 = UQ_dH1*dH1;
        BFBrgnT.dH2 = UQ_dH2*dH2;
        BFBrgnT.dH3 = UQ_dH3*dH3;
        BFBrgnT.dS1 = UQ_dS1*dS1;
        BFBrgnT.dS2 = UQ_dS2*dS2;
        BFBrgnT.dS3 = UQ_dS3*dS3;
        BFBrgnT.nv = UQ_nv*nv;

        // Top Regenerator Fixed Value Variables
