        BFBrgnT.UQ_Kcebs = UQ_Kcebs;
        BFBrgnT.UQ_Hbc = UQ_Hbc;
        BFBrgnT.UQ_Hce = UQ_Hce;
        BFBrgnT.UQ_hp = UQ_hp;
        BFBrgnT.UQ_hl = UQ_hl;
        BFBrgnT.UQ_hd = UQ_hd;


        // Total process consumptions
        Ele_tot = (adsN*CMPads.J + rgnN*CMPrgn.J)/1000;
        Q_tot = rgnN*(abs(BFBrgnB.Q) + abs(BFBrgnT.Q));
        Inj_MP = rgnN*SINJ.Steam.F;

