        BFBrgnT.emf = UQ_emf*emf;
        BFBrgnT.fw = UQ_fw*fw;
        BFBrgnT.hw = UQ_hw*hw;
        BFBrgnT.Kd = UQ_Kd*Kd;
        BFBrgnT.nor = UQ_nor*nor;

        // Top Regenerator Correlated Variables
