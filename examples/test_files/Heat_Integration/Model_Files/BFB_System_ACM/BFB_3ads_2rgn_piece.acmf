Model Split

// Gas Stream split unit

Feed            as Input MainPort;
Out1            as Output MainPort;
Out2            as Output MainPort;

Feed.F = Out1.F + Out2.F;

Feed.P = Out1.P;
Feed.T = Out1.T;
Feed.z = Out1.z;

Feed.P = Out2.P;
Feed.T = Out2.T;
Feed.z = Out2.z;

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
SystemData : Text
<FORMLIST DEFAULTFORM="AllVariables">
</FORMLIST>
EndText;

//SYSTEM SECTION END
End
Model Injector

Steam           AS Input MainPort;
GasIn           AS Input MainPort;
GasOut          AS Output MainPort;

GasOut.P = GasIn.P;

GasOut.F = GasIn.F + Steam.F;

GasOut.z*GasOut.F = GasIn.z*GasIn.F + Steam.z*Steam.F;

GasOut.h*GasOut.F = GasIn.h*GasIn.F + Steam.h*Steam.F;

Call(GasIn.h) = pEnth_Mol_Vap (GasIn.T, GasIn.P, GasIn.z);
Call(GasOut.h) = pEnth_Mol_Vap (GasOut.T, GasOut.P, GasOut.z);
Call(Steam.T) = pDewT (Steam.P, Steam.z);
Call(Steam.h) = pEnth_Mol_Vap (Steam.T, Steam.P, Steam.z);

