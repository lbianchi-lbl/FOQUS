FLOWSHEET
  BFBadsB as BFB;
  BFBadsT as BFB;
  CMPads as PolyComp;
  BFBrgnT as BFB;
  BFBrgnB as BFB;
  GHXfg as GHX;
  LR_SHXrich as SHX;
  LR_SHXlean as SHX;
  CW_SHXlean as SHX2;
  SPTR as Split;
  CMPrgn as PolyComp;
  SINJ as Injector;
  GHXcmp as GHX;
  GasIn_adsB as Connection;
  GasIn_adsT as Connection;
  SolidOut_adsB as Connection;
  SolidIn_adsT as Connection;
  SolidIn_adsB as Connection;
  TO_STACK as Connection;
  Flue_Gas1 as Connection;
  GasIn_rgnT as Connection;
  SolidIn_rgnB as Connection;
  SolidIn_rgnT as Connection;
  SolidOut_rgnB as Connection;
  GasOut_rgnT as Connection;
  GasIn_rgnB as Connection;
  Flue_Gas as Connection;
  SolidIn_rgn as Connection;
  SolidIn_ads0 as Connection;
  SolidIn_ads1 as Connection;
  Recycle_rgn0 as Connection;
  Recycle_rgn1 as Connection;
  GasOut_rgn0 as Connection;
  TO_COMP as Connection;
  Connect CMPads.GasOut and BFBadsB.GasIn with GasIn_adsB;
  Connect BFBadsB.GasOut and BFBadsT.GasIn with GasIn_adsT;
  Connect BFBadsB.SolidOut with SolidOut_adsB;
  Connect BFBadsT.SolidIn with SolidIn_adsT;
  Connect BFBadsT.SolidOut and BFBadsB.SolidIn with SolidIn_adsB;
  Connect BFBadsT.GasOut with TO_STACK;
  Connect GHXfg.GasOut and CMPads.GasIn with Flue_Gas1;
  Connect BFBrgnB.GasOut and BFBrgnT.GasIn with GasIn_rgnT;
  Connect BFBrgnT.SolidOut and BFBrgnB.SolidIn with SolidIn_rgnB;
  Connect LR_SHXrich.SolidOut and BFBrgnT.SolidIn with SolidIn_rgnT;
  Connect BFBrgnB.SolidOut and LR_SHXlean.SolidIn with SolidOut_rgnB;
  Connect BFBrgnT.GasOut and SPTR.Feed with GasOut_rgnT;
  Connect BFBrgnB.GasIn with GasIn_rgnB;
  Connect GHXfg.GasIn with Flue_Gas;
  Connect LR_SHXrich.SolidIn with SolidIn_rgn;
  Connect LR_SHXlean.SolidOut and CW_SHXlean.SolidIn with SolidIn_ads0;
  Connect CW_SHXlean.SolidOut with SolidIn_ads1;
  Connect SPTR.Out1 and CMPrgn.GasIn with Recycle_rgn0;
  Connect CMPrgn.GasOut and SINJ.GasIn with Recycle_rgn1;
  Connect SPTR.Out2 and GHXcmp.GasIn with GasOut_rgn0;
  Connect GHXcmp.GasOut with TO_COMP;

CONSTRAINTS
/*
Two-stage adsorption, two-stage regeneration CO2 capture process using CCSI BFB Model v5.2.2
Juan Morinelly (2013)
*/
// =============================================================================================================
// Declare Flowsheet Variables

removalCO2              as NoType           (description:"Adsorption CO2 removal fraction");
removalH2O              as NoType           (description:"Adsorption H2O removal fraction");
lean_loading            as Loading          (description:"Sorbent loading at adsorption feed (mol/kg solid)");
rich_loading            as Loading          (description:"Sorbent loading at regeneration feed (mol/kg solid)");
delta_loading           as Loading          (description:"Process sorbent work loading (mol/kg solid)");                                                  

dPads                   as Press_Drop       (description:"Adsorption pressure drop (bar)");
dPrgn                   as Press_Drop       (description:"Regeneration pressure drop (bar)");

FGIn                    as Flow_Mol         (description:"Flue gas flowrate (kmol/hr)", 100377, Fixed);

adsDt                   as Length           (description:"Adsorption units diameter (m)");
rgnDt                   as Length           (description:"Regeneration units diameter (m)");
adsdx                   as Length           (description:"Adsorption units HX tubes diameter (m)");
rgndx                   as Length           (description:"Regeneration units HX tubes diameter (m)");
adslhx                  as Length           (description:"Adsorption units HX tubes spacing (m)");
rgnlhx                  as Length           (description:"Regeneration units HX tubes spacing (m)");
adsN                    as NoType           (description:"Number of parallel adsorption trains");
rgnN                    as NoType           (description:"Number of parallel regeneration trains");

Ele_tot                 as Power            (description:"Total electricity consumption (MW)");
Q_tot                   as EnthFlow         (description:"Total heat consumption (GJ/hr)");
Inj_MP                  as Flow_Mol         (description:"MP steam injection rate (kmol/hr)");

// =============================================================================================================
// Flowsheet Equations

// -------------------------------------------------------------------------------------------------------------
        // Equations to Satisfy DOF
        Call(BFBadsB.GasIn.h) = pEnth_Mol_Vap(BFBadsB.GasIn.T,BFBadsB.GasIn.P,BFBadsB.GasIn.z);
        Call(BFBadsT.GasIn.h) = pEnth_Mol_Vap(BFBadsT.GasIn.T,BFBadsT.GasIn.P,BFBadsT.GasIn.z);
        Call(BFBrgnT.GasIn.h) = pEnth_Mol_Vap(BFBrgnT.GasIn.T,BFBrgnT.GasIn.P,BFBrgnT.GasIn.z);
        Call(SPTR.Feed.h) = pEnth_Mol_Vap(SPTR.Feed.T,SPTR.Feed.P,SPTR.Feed.z);
        Call(CMPrgn.GasIn.h) = pEnth_Mol_Vap(CMPrgn.GasIn.T,CMPrgn.GasIn.P,CMPrgn.GasIn.z);

        // Adsorption Removal
        removalCO2 = 1 - BFBadsT.GasOut.F*BFBadsT.GasOut.z("CO2")/(BFBadsB.GasIn.F*BFBadsB.GasIn.z("CO2"));
        removalH2O = 1 - BFBadsT.GasOut.F*BFBadsT.GasOut.z("H2O")/(BFBadsB.GasIn.F*BFBadsB.GasIn.z("H2O"));

        // Sorbent Loading
        lean_loading = sigma(BFBadsT.SolidIn.w);
        rich_loading = sigma(BFBrgnT.SolidIn.w);
        delta_loading = rich_loading - lean_loading;

        // Overall Pressure Drop
        dPads = BFBadsB.GasIn.P - BFBadsT.GasOut.P;
        dPrgn = BFBrgnB.GasIn.P - BFBrgnT.GasOut.P;

        // Single Train Flue Gas Flowrate
        FGIn = adsN*GHXfg.GasIn.F;

        // Vessels Specification
        adsDt = BFBadsB.Dt;
        adsDt = BFBadsT.Dt;
        rgnDt = BFBrgnB.Dt;
        rgnDt = BFBrgnT.Dt;
        adsdx = BFBadsB.dx;
        adsdx = BFBadsT.dx;
        rgndx = BFBrgnB.dx;
        rgndx = BFBrgnT.dx;
        adslhx = BFBadsB.lhx;
        adslhx = BFBadsT.lhx;
        rgnlhx = BFBrgnB.lhx;
        rgnlhx = BFBrgnT.lhx;

        // Lean-Rich Solid Heat Exchanger Equations
        LR_SHXlean.SolidOut.T = BFBadsB.SolidOut.T + 10; //Assumes 10 °C temperature approach
        LR_SHXrich.Q = -LR_SHXlean.Q;

        // Integration of Adsorption and Regeneration Sections
        LR_SHXrich.SolidIn.Fm = BFBadsB.SolidOut.Fm*adsN/rgnN;
        LR_SHXrich.SolidIn.T = BFBadsB.SolidOut.T;
        LR_SHXrich.SolidIn.w = BFBadsB.SolidOut.w;
        BFBadsT.SolidIn.T = CW_SHXlean.SolidOut.T;
        BFBadsT.SolidIn.w = CW_SHXlean.SolidOut.w;

        // Regeneration Gas Recirculation
        BFBrgnB.GasIn.F = SINJ.GasOut.F;
        BFBrgnB.GasIn.T = SINJ.GasOut.T;
        BFBrgnB.GasIn.z = SINJ.GasOut.z;
        CMPrgn.DischP = BFBrgnB.GasIn.P;

        // Total process consumptions
        Ele_tot = (adsN*CMPads.J + rgnN*CMPrgn.J)/1000;
        Q_tot = rgnN*(abs(BFBrgnB.Q) + abs(BFBrgnT.Q));
        Inj_MP = rgnN*SINJ.Steam.F;

// =============================================================================================================

// =============================================================================================================
// Input Variables

Flue_Gas_F              as Flow_Mol         (description:"Molar flow rate of flue gas (kmol/hr)");
Flue_Gas_T              as Temperature      (description:"Temperature of flue gas (C)"); 
Flue_Gas_P              as Pressure         (description:"Pressure of flue gas (bar)");
Flue_Gas_z_CO2          as Molefraction     (description:"Mole fraction of CO2 in flue gas (kmol/kmol)");
Flue_Gas_z_H2O          as Molefraction     (description:"Mole fraction of H2O in flue gas (kmol/kmol)");
Flue_Gas_z_N2           as Molefraction     (description:"Mole fraction of N2 in flue gas (kmol/kmol)");

        Flue_Gas_F = FGIn;
        Flue_Gas_T = GHXfg.GasIn.T;
        Flue_Gas_P = GHXfg.GasIn.P;
        Flue_Gas_z_CO2 = GHXfg.GasIn.z("CO2");
        Flue_Gas_z_H2O = GHXfg.GasIn.z("H2O");
        Flue_Gas_z_N2 = GHXfg.GasIn.z("N2");

// =============================================================================================================

// =============================================================================================================
// Output Variables

To_Comp_F               as Flow_Mol         (description:"Molar flow rate of CO2 stream to compressors (kmol/hr)");
To_Comp_T               as Temperature      (description:"Temperature of CO2 stream to compressors (C)"); 
To_Comp_P               as Pressure         (description:"Pressure of CO2 stream to compressors (bar)");
To_Comp_z_CO2           as Molefraction     (description:"Mole fraction of CO2 in CO2 stream to compressors (kmol/kmol)");
To_Comp_z_H2O           as Molefraction     (description:"Mole fraction of H2O in CO2 stream to compressors (kmol/kmol)");
To_Comp_z_N2            as Molefraction     (description:"Mole fraction of N2 in CO2 stream to compressors (kmol/kmol)");

        To_Comp_F = rgnN*GHXcmp.GasOut.F;
        To_Comp_T = GHXcmp.GasOut.T;
        To_Comp_P = GHXcmp.GasOut.P;
        To_Comp_z_CO2 = GHXcmp.GasOut.z("CO2");
        To_Comp_z_H2O = GHXcmp.GasOut.z("H2O");
        To_Comp_z_N2 = GHXcmp.GasOut.z("N2");

// =============================================================================================================

// =============================================================================================================
// Heat Integration Variables

GHXfg_GasIn_T           as Temperature      (description:"Inlet temperature of GHXfg (C)");
GHXfg_GasOut_T          as Temperature      (description:"Outlet temperature of GHXfg (C)");
GHXfg_Q                 as EnthFlow         (description:"Heat duty of GHXfg (GJ/hr)");
GHXcmp_GasIn_T          as Temperature      (description:"Inlet temperature of GHXcmp (C)");
GHXcmp_GasOut_T         as Temperature      (description:"Outlet temperature of GHXcmp (C)");
GHXcmp_Q                as EnthFlow         (description:"Heat duty of GHXcmp (GJ/hr)");
LR_SHXrich_SolidIn_T    as Temperature      (description:"Inlet temperature of LR_SHXrich (C)");
LR_SHXrich_SolidOut_T   as Temperature      (description:"Outlet temperature of LR_SHXrich (C)");
LR_SHXrich_Q            as EnthFlow         (description:"Heat duty of LR_SHXrich (GJ/hr)");
LR_SHXlean_SolidIn_T    as Temperature      (description:"Inlet temperature of LR_SHXlean (C)");
LR_SHXlean_SolidOut_T   as Temperature      (description:"Outlet temperature of LR_SHXlean (C)");
LR_SHXlean_Q            as EnthFlow         (description:"Heat duty of LR_SHXlean (GJ/hr)");
CW_SHXlean_SolidIn_T    as Temperature      (description:"Inlet temperature of CW_SHXlean (C)");
CW_SHXlean_SolidOut_T   as Temperature      (description:"Outlet temperature of CW_SHXlean (C)");
CW_SHXlean_Q            as EnthFlow         (description:"Heat duty of CW_SHXlean (GJ/hr)");
BFBadsB_Tse             as Temperature      (description:"Temperature of BFBadsB (C)");
BFBadsB_Q               as EnthFlow         (description:"Heat duty of BFBadsB (GJ/hr)");
BFBadsT_Tse             as Temperature      (description:"Temperature of BFBadsT (C)");
BFBadsT_Q               as EnthFlow         (description:"Heat duty of BFBadsT (GJ/hr)");
BFBrgnB_Tse             as Temperature      (description:"Temperature of BFBrgnB (C)");
BFBrgnB_Q               as EnthFlow         (description:"Heat duty of BFBrgnB (GJ/hr)");
BFBrgnT_Tse             as Temperature      (description:"Temperature of BFBrgnT (C)");
BFBrgnT_Q               as EnthFlow         (description:"Heat duty of BFBrgnT (GJ/hr)");

        GHXfg_GasIn_T = GHXfg.GasIn.T;
        GHXfg_GasOut_T  = GHXfg.GasOut.T;
        GHXfg_Q = adsN*GHXfg.Q;
        GHXcmp_GasIn_T = GHXcmp.GasIn.T;
        GHXcmp_GasOut_T  = GHXcmp.GasOut.T;
        GHXcmp_Q = rgnN*GHXcmp.Q;
        LR_SHXrich_SolidIn_T = LR_SHXrich.SolidIn.T;
        LR_SHXrich_SolidOut_T = LR_SHXrich.SolidOut.T;
        LR_SHXrich_Q = rgnN*LR_SHXrich.Q;
        LR_SHXlean_SolidIn_T = LR_SHXlean.SolidIn.T;
        LR_SHXlean_SolidOut_T = LR_SHXlean.SolidOut.T;
        LR_SHXlean_Q = rgnN*LR_SHXlean.Q;
        CW_SHXlean_SolidIn_T = CW_SHXlean.SolidIn.T;
        CW_SHXlean_SolidOut_T = CW_SHXlean.SolidOut.T;
        CW_SHXlean_Q = rgnN*CW_SHXlean.Q;
        BFBadsB_Tse = BFBadsB.Tse.Value(99);
        BFBadsB_Q = adsN*BFBadsB.Q;
        BFBadsT_Tse = BFBadsT.Tse.Value(99);
        BFBadsT_Q = adsN*BFBadsT.Q;
        BFBrgnB_Tse = BFBrgnB.Tse.Value(99);
        BFBrgnB_Q = rgnN*BFBrgnB.Q;
        BFBrgnT_Tse = BFBrgnT.Tse.Value(99);
        BFBrgnT_Q = rgnN*BFBrgnT.Q;

// =============================================================================================================

END

