call Port.at(-0.399576,0.00128865)
call Port.direction(0)
call Port.name("UniversalOUT")
call Port.at(0.400007,0.00128865)
call Port.IOtype(1)
call Port.direction(0)
end sub



endtext

SHX2_T0_I0 as SHX2_T0;
