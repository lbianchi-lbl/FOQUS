Model SHX
/*
Simple Heat Exchanger Model for the Feed of Regenerator - Direct Control of dT
Adapted by Juan Morinelly (2013) from previous model by Hosoo Kim (2012)
Last updated: Juan Morinelly (Mar. 2013)
*/
// ===========================================================================================================================================
// Heat Exchange Parameters

Q                       as Enthflow           (description:"Required heat (GJ/hr)");
DeltaT                  as Temperature        (description:"Temperature difference (°C)", 10.0);

// -------------------------------------------------------------------------------------------------------------------------------------------
// Solid phase parameters

Pamb                    as Pressure           (description:"Local ambient pressure (bar)", 1.01325, Fixed);
cps                     as cp_mass            (description:"Specific heat capacity of sorbent (kJ/kg/K)", 1.13, Fixed);
zads(componentlist)     as Molefraction       (description:"Fraction of adsorbed species that containin a given gas");
hadsIn                  as Enth_Mol           (description:"Sorbent inlet adsorbed gas enthalpy contribution (GJ/kmol)");
hadsOut                 as Enth_Mol           (description:"Sorbent outlet adsorbed gas enthalpy contribution (Gj/kmol)");

// -------------------------------------------------------------------------------------------------------------------------------------------
// Ports

SolidIn                 as Input              SorbentPort;
SolidOut                as Output             SorbentPort;

// ===========================================================================================================================================
// Model Equations

// -------------------------------------------------------------------------------------------------------------------------------------------
        // Solid Side Calculations
        zads("CO2") = (SolidIn.w("Bic")+SolidIn.w("Car"))/sigma(SolidIn.w);
        zads("H2O") = (SolidIn.w("Bic")+SolidIn.w("H2O"))/sigma(SolidIn.w);
        zads("N2")  = 0;
        CALL(hadsIn) = pEnth_Mol_Vap(SolidIn.T, Pamb, zads(componentlist));
        CALL(hadsOut) = pEnth_Mol_Vap(SolidOut.T, Pamb, zads(componentlist));

        // Heat Exchange Equations (Assumes heat transfered to solid is the sum of contributions from adsorbed gas and the sorbent material)
        DeltaT = SolidOut.T - SolidIn.T;
        Q = SolidOut.Fm*sigma(SolidOut.w)*(hadsOut - hadsIn)/1000 + 1E-6*cps*SolidOut.Fm*DeltaT; // 1000 mol, 1E-6 GJ -> 1 kmol, 1 kJ

        // SolidOut Outlet Stream Properties
        SolidOut.Fm = SolidIn.Fm;
        SolidOut.w = SolidIn.w;

// ===========================================================================================================================================

