Model PolyComp
/*
Simple Polytropic Gas Compressor Model
Adapted by Juan Morinelly (2011) from previous model by Andrew Lee (2011)
Last Updated: Juan Morinelly (Feb. 2013)
*/
// ======================================================================================================================
// Global Parameters

R                       as hidden RealParameter   (description:"Universal gas constant, J/(mol.K)", 8.314472);
  
// Compression Parameters

DischP                  as Pressure               (description:"Discharge pressure (bar)");
Ep                      as Fraction               (description:"Polytropic efficiency of compressor", 0.78, Fixed);
MWavg                   as MolWeight              (description:"Average molecular weight of gas (kg/kmol)");
cp                      as cp_mol_vap             (description:"Constant pressure heat capacity of gas (kJ/kmol/K)");
cv                      as cv_mol_vap             (description:"Constant volume heat capacity of gas (kJ/kmol/K)");
gamma                   as Notype                 (description:"Ratio of specific heats");
m                       as Notype                 (description:"Polytropic model coefficient");
n                       as Notype                 (description:"Polytropic model coefficient");
Z                       as Notype                 (description:"Compressibility factor of gas at inlet conditions");
Tout                    as Temperature            (description:"Temperature of discharge gas (°C)");
rhoin                   as Dens_Mol_Vap           (description:"Molar density of feed gas (kmol/m^3)");
vin                     as Vol_Mol_Vap            (description:"Molar volume of feed gas (m^3/kmol)");
J                       as Power                  (description:"Electrical power requirement of compressor motor (kW)");
W                       as Notype                 (description:"Mechanical work required by compressor (kJ/kmol)");
eta                     as Fraction               (description:"Electrical efficiency of motor", 0.97, Fixed);

// Ports
GasIn                   as Input                  MainPort;
GasOut                  as Output                 MainPort;

// ======================================================================================================================
// Model Equations

// ----------------------------------------------------------------------------------------------------------------------
        // Polytropic Calculations (Based on equations in Ch. 3 of Towler & Sinnott, 2007)
        Call(cp) = pcp_Mol_Vap(GasIn.T, GasIn.P, GasIn.z);
        Call(cv) = pcv_Mol_Vap(GasIn.T, GasIn.P, GasIn.z);
        Call(rhoin) = pDens_Mol_Vap(GasIn.T, GasIn.P, GasIn.z);
        vin = 1/rhoin;
        gamma = cp/cv;
        m = (gamma-1)/(gamma*Ep);
        n = 1/(1-m);
        Z = GasIn.P*vin/(R*1E-2*(GasIn.T + 273.15));//1 kmol = 1E3mol, 1J = 1E-5bar*m^3

        // Mechanical Work and Power Requirement Calculations
        Call(MWavg) = pMolWeight(GasIn.z);
        -W = (1/Ep)*Z*R*(GasIn.T + 273.15)*n/(n-1)*(((GasOut.P/GasIn.P)^((n-1)/n))-1);
        J = -GasIn.F*W/(eta*3600);//1 hr = 3600 s, 1 kW = 1 kJ/s

        // GasOut Temperature Calculation
        Tout + 273.15 = (GasIn.T + 273.15)*((DischP/GasIn.P)^m);

        // GasOut Outlet Stream Properties
        GasOut.F = GasIn.F;
        GasOut.z = GasIn.z;
        GasOut.T = Tout;
        GasOut.P = DischP;

// ======================================================================================================================

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
