Model SHX2
/*
Simple Heat Exchanger Model for the Feed of Regenerator - Direct Control of dT
Adapted by Juan Morinelly (2013) from previous model by Hosoo Kim (2012)
Last updated: Juan Morinelly (Mar. 2013)
*/
// ===========================================================================================================================================
// Heat Exchange Parameters

Q                       as Enthflow           (description:"Required heat (GJ/hr)");
A_exch                  as Area               (description:"Required area (m^2)");
LMTD                    as Temperature        (description:"Log mean temperature difference (K)");
U                       as Heat_Trans_Coeff   (description:"Overall heat transfer coefficient (kW/m^2/K)", 0.10, Fixed);
dPhx                    as Press_Drop         (description:"Pressure drop HX fluid side (bar)", 0.01, Fixed);
DeltaT                  as Temperature        (description:"Temperature difference (°C)", 10.0);

// -------------------------------------------------------------------------------------------------------------------------------------------
// Solid phase parameters

Pamb                    as Pressure           (description:"Local ambient pressure (bar)", 1.01325, Fixed);
cps                     as cp_mass            (description:"Specific heat capacity of sorbent (kJ/kg/K)", 1.13, Fixed);
zads(componentlist)     as Molefraction       (description:"Fraction of adsorbed species that containin a given gas");
hadsIn                  as Enth_Mol           (description:"Sorbent inlet adsorbed gas enthalpy contribution (GJ/kmol)");
hadsOut                 as Enth_Mol           (description:"Sorbent outlet adsorbed gas enthalpy contribution (Gj/kmol)");

// -------------------------------------------------------------------------------------------------------------------------------------------
// HX Flash Parameters

HXIn_VF                 as VapFraction         (description:"HX fluid inlet vapor fraction (kmol/kmol)");
HXIn_x(componentlist)   as Molefraction        (description:"HX fluid inlet vapor phase mole fraction (kmol/kmol)");
HXIn_y(componentlist)   as Molefraction        (description:"HX fluid inlet liquid phase mole fraction (kmol/kmol)");
HXIn_hv                 as Enth_Mol_Vap        (description:"HX fluid inlet vapor phase molar enthalpy (GJ/kmol)");
HXIn_hl                 as Enth_Mol_Liq        (description:"HX fluid inlet liquid phase molar enthalpy (GJ/kmol)");
HXOut_VF                as VapFraction         (description:"HX fluid outlet vapor fraction (kmol/kmol)");
HXOut_x(componentlist)  as Molefraction        (description:"HX fluid outlet vapor phase mole fraction (kmol/kmol)");
HXOut_y(componentlist)  as Molefraction        (description:"HX fluid outlet liquid phase mole fraction (kmol/kmol)");
HXOut_hv                as Enth_Mol_Vap        (description:"HX fluid outlet vapor phase molar enthalpy (GJ/kmol)");
HXOut_hl                as Enth_Mol_Liq        (description:"HX fluid outlet liquid phase molar enthalpy (GJ/kmol)");

// -------------------------------------------------------------------------------------------------------------------------------------------
// Ports

SolidIn                 as Input              SorbentPort;
SolidOut                as Output             SorbentPort;

HXIn                    as Input              MainPort;
HXOut                   as Output             MainPort;

// ===========================================================================================================================================
// Model Equations

// -------------------------------------------------------------------------------------------------------------------------------------------
        // Solid Side Calculations
        zads("CO2") = (SolidIn.w("Bic")+SolidIn.w("Car"))/sigma(SolidIn.w);
        zads("H2O") = (SolidIn.w("Bic")+SolidIn.w("H2O"))/sigma(SolidIn.w);
        zads("N2")  = 0;
        CALL(hadsIn) = pEnth_Mol_Vap(SolidIn.T, Pamb, zads(componentlist));
        CALL(hadsOut) = pEnth_Mol_Vap(SolidOut.T, Pamb, zads(componentlist));

        // HX Fluid Side Calculations
        Call (HXIn_y, HXIn_x, HXIn_VF, HXIn_hv, HXIn_hl) = pFlash (HxIn.T, HXIn.P, HXIn.z(componentlist));
        Call (HXOut_y, HXOut_x, HXOut_VF, HXOut_hv, HXOut_hl) = pFlash (HXOut.T, HXOut.P, HXOut.z(componentlist));
        HXIn.h = HXIn_hv*HXIn_VF + HXIn_hl*(1-HXIn_VF);
        HXOut.h = HXOut_hv*HXOut_VF + HXOut_hl*(1-HXOut_VF);

        // Heat Exchange Equations (Assumes heat transfered to solid is the sum of contributions from adsorbed gas and the sorbent material)
        DeltaT = SolidOut.T - SolidIn.T;
        Call (LMTD) = pLMTD (SolidIn.T, HXIn.T, SolidOut.T, HXOut.T, "Countercurrent");
        Q = U*A_exch*LMTD*3600*1E-6; // 3600 s, 1E-6 GJ -> 1 hr, 1 kJ
        Q = SolidOut.Fm*sigma(SolidOut.w)*(hadsOut - hadsIn)/1000 + 1E-6*cps*SolidOut.Fm*DeltaT; // 1000 mol, 1E-6 GJ -> 1 kmol, 1 kJ
        -Q = HXIn.F*(HXOut.h - HxIn.h);

        // SolidOut Outlet Stream Properties
        SolidOut.Fm = SolidIn.Fm;
        SolidOut.w = SolidIn.w;

        // HXOut Outlet Stream Properties  
        HXOut.F = HXIn.F;
        HxOut.P = HxIn.P - dPhx;
        HxOut.z(componentlist) = HxIn.z(componentlist);

// ===========================================================================================================================================

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
TYPE SHX2_T0 ROLE "ICON" text
Name = Default
lines = 57

