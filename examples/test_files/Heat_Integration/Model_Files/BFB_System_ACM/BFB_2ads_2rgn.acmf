Version "25.0-0";
Libraries "Modeler.acml", "SystemLibrary.acml";
Parameter SOType Uses StringParameter
Valid as StringSet (["Overflow","Underflow"]);
Value: "Overflow";
End
Parameter SIType Uses StringParameter
Valid as StringSet (["Top","Bottom"]);
Value: "Top";
End
Parameter IPselector Uses StringParameter
 Valid as StringSet (["Rigorous","Initial"]);
 Value: "Rigorous";
End
Variable loading /* mol/kg solid */
Lower: 1E-3;
Upper: 1E3;
Value: 1.0;
PhysicalQuantity : "mol/kg solid";
// Scale : <scaling value>;
End
Variable conc_mole_solid /* mol/m3 */
 Lower: 0;
 Upper: 1E6;
 Value: 1E2;
 PhysicalQuantity : "mol/m3";
End
Port SorbentPort
 adslist        as stringset (["H2O", "Bic", "Car"]);
 Fm             as flow_mass (description:"Mass Flowrate (kg/hr)");
 w(adslist)     as loading (description:"Loading (mol/kg)");
 T              as temperature;
End
Model BFB
/*
FOQUS Copyright (c) 2012 - 2021, by the software owners: Oak Ridge Institute
for Science and Education (ORISE), TRIAD National Security, LLC., Lawrence
Livermore National Security, LLC., The Regents of the University of
California, through Lawrence Berkeley National Laboratory, Battelle Memorial
Institute, Pacific Northwest Division through Pacific Northwest National
Laboratory, Carnegie Mellon University, West Virginia University, Boston
University, the Trustees of Princeton University, The University of Texas at
Austin, URS Energy & Construction, Inc., et al.  All rights reserved.

Please see the file LICENSE.md for full copyright and license information,
respectively. This file is also available online at the URL
"https://github.com/CCSI-Toolset/FOQUS".

CCSI Kunii-Levenspiel Model for a Bubbling Fluidized Bed, v0.10.c2 ACM Version (v5.2.2 for NETL internal use)
With respect to version v0.9.c1 the model syntax was updated to reflect the following changes:
- Further revision of energy balances based on paper by Walton and LeVan. A specific enthalpy is now calculated for all solid flows which includes the adsorbed species and heat of reaction.
- Modified solids circulation calculations to better reflect Kunii and Levenspiel’s analysis. 
- Added correlation for emulsion phase gas velocity for Group B particles.
- Added calculation of hydraulic diameter to model to account for effects of internal heat exchangers on hydrodynamics, and integrated this with existing correlations.
- Added bubble velocity calculation for slug flow conditions arising due bubbles being limited by hydraulic diameter.
- Modified solid boundary conditions to allow for top and bottom solid inlets.
- Added terms to account for pressure drop and heat transfer resistance in heat exchanger tubes.
- Replaced total gas balance with sum of mole fractions relationship for the bubble phase to address singularity issue in dynamic simulations.

Main model developer: Andrew Lee, March 2012

For a detailed description of the model please refer to:
A. Lee and D.C. Miller, A One-Dimensional (1-D) Three-Region Model for a Bubbling Fluidized-Bed Adsorber, I&ECR, 2013 52(1), 469-484.

Modified by: Juan Morinelly.

- Organized syntax
- Correction in solid mass balances boundary conditions
- Corrected unit conversion error in heat exchanger tube energy balance
- Minor error correction in calculating solids residence time.
- Modified solid ports type
- Added initialization procedure (script, variables, and simplified equations)
- Added distributed variables for adsorbed species solids loading
- Modified heat exchanger model to single pass counter-current to gas flow
- Added pre-defined distributed variable plots and input/output tables
- Added variable for inlet heat exchange fluid velocity, vhx
- Added variables for heat exchanger tube spacing and tube wall thickness, lhx and wthx
- Added variable for gas superficial velocity at inlet, vgi
- Added flash call for heat exchanger inlet

Last Modification date: February 2013

*/
// =======================================================================================================================================================================================================
// Declare Parameters

pi                      as hidden RealParameter                                     (description:"Circumference to Diameter ratio for a circle", 2*acos(0));
R                       as hidden RealParameter                                     (description:"Universal Gas Constant, J/(mol.K)", 8.314472);
gc                      as hidden RealParameter                                     (description:"Gravitational Acceleration Constant (m/s^2)", 9.81);

ND                      as IntegerParameter                                         (description:"Number of Discretization Points", 100);

SIType                  as SIType                                                   (description:"Solids Inlet Type (Top or Bottom)");
SOType                  as SOType                                                   (description:"Solids Outlet Type (Overflow or Underflow)");

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Declare Distribution Domain

l                       as Domain                                                   (Length : ND-1, SpacingPreference : 1, NumSections : 1, DiscretizationMethod : "BFD1");

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Declare Model Variables

Ahx                     as area                                                     (description:"Surface Area of Heat Exchanger Tubes (m^2)");
Ao                      as area                                                     (description:"Area of Distributor Plate per Orifice (m^2/orifice)");
Areact                  as area                                                     (description:"Total Reactor Cross-Sectional Area (m^2)");
Ax                      as area                                                     (description:"Total Bed Cross-Sectional Area (m^2)");
Dt                      as length                                                   (description:"Single Unit Diameter (m)");
Dte                     as length                                                   (description:"Hydraulic Diameter (m)");
Lb                      as length                                                   (description:"Bed Depth (m)");
nor                     as notype                                                   (description:"Number of Orifices per Square Meter in Distributor Plate (m^-2)");

dl                      as length                                                   (description:"Length of Model Cell (m)");

P                       as Distribution1D(XDomain is l) of pressure                 (description:"Bed Pressure (bar)");
Tgb                     as Distribution1D(XDomain is l) of temperature              (description:"Bubble Region Gas Temperature (Celcius)");
Tsc                     as Distribution1D(XDomain is l) of temperature              (description:"Cloud-Wake Region Solids Temperature (Celcius)");
Tse                     as Distribution1D(XDomain is l) of temperature              (description:"Emulsion Region Solids Temperature (Celcius)");
Tgc                     as hidden Distribution1D(XDomain is l) of temperature       (description:"Cloud-Wake Region Gas Temperature (Celcius)");
Tge                     as hidden Distribution1D(XDomain is l) of temperature       (description:"Emulsion Region Gas Temperature (Celcius)");

Gb                      as Distribution1D(XDomain is l) of flow_mol_vap             (description:"Gas Flowrate in Bubbles (kmol/hr)");
Jc                      as hidden Distribution1D(XDomain is l) of flux_mass         (description:"Cloud-Wake Region Solids Flux (superficial) (kg/m^2.s)");
Je                      as hidden Distribution1D(XDomain is l) of flux_mass         (description:"Emulsion Region Solids Flux (superficial) (kg/m^2.s)");

yb(componentlist)       as Distribution1D(XDomain is l) of molefraction             (description:"Bubble Region Gas Mole Fractions (kmol/kmol)");
yc(componentlist)       as hidden Distribution1D(XDomain is l) of molefraction      (description:"Cloud-Wake Region Gas Mole Fractions (kmol/kmol)");
ye(componentlist)       as hidden Distribution1D(XDomain is l) of molefraction      (description:"Emulsion Region Gas Mole Fractions (kmol/kmol)");
cb(componentlist)       as hidden Distribution1D(XDomain is l) of conc_mole         (description:"Bubble Region Gas Concentrations (kmol/m^3)");
cc(componentlist)       as hidden Distribution1D(XDomain is l) of conc_mole         (description:"Cloud-Wake Region Gas Concentrations (kmol/m^3)");
ce(componentlist)       as hidden Distribution1D(XDomain is l) of conc_mole         (description:"Emulsion Region Gas Concentrations (kmol/m^3)");

w_H2O                   as Distribution1D(XDomain is l) of loading                  (description:"Emulsion Region Solid Sorbent Physisorbed Water Loading (mol/kg)");
w_Bic                   as Distribution1D(XDomain is l) of loading                  (description:"Emulsion Region Solid Sorbent Bicarbonate Loading (mol/kg)");
w_Car                   as Distribution1D(XDomain is l) of loading                  (description:"Emulsion Region Solid Sorbent Carbamate Loading (mol/kg)");
w_t                     as Distribution1D(XDomain is l) of loading                  (description:"Emulsion Region Solid Sorbent Total Loading (mol/kg)");

hsinb                   as hidden notype                                            (description:"Sorbent Specific Enthalpy in Inlet Solids (Bottom Inlet) (kJ/kg)");
hsint                   as hidden notype                                            (description:"Sorbent Specific Enthalpy in Inlet Solids (Top Inlet) (kJ/kg)");
hsc                     as hidden Distribution1D(XDomain is l) of notype            (description:"Sorbent Specific Enthalpy in Cloud-Wake Region (kJ/kg)");
hse                     as hidden Distribution1D(XDomain is l) of notype            (description:"Sorbent Specific Enthalpy in Emulsion Region (kJ/kg)");

nin(componentlist)      as hidden conc_mole_solid                                   (description:"Sorbent Inlet Adsorbed Species Concentrations (mol/m^3)");
nc(componentlist)       as hidden Distribution1D(XDomain is l) of conc_mole_solid   (description:"Cloud-Wake Region Adsorbed Species Concentrations (mol/m^3)");
ne(componentlist)       as hidden Distribution1D(XDomain is l) of conc_mole_solid   (description:"Emulsion Region Adsorbed Species Concentrations (mol/m^3)");

us                      as Distribution1D(XDomain is l) of velocity                 (description:"Emulsion Region Solids Velocity (Downwards) (m/s)");
vb                      as Distribution1D(XDomain is l) of velocity                 (description:"Bubble Velocity (m/s)");
vbr                     as Distribution1D(XDomain is l) of velocity                 (description:"Bubble Rise Velocity (m/s)");
ve                      as Distribution1D(XDomain is l) of velocity                 (description:"Emulsion Region Gas Velocity (m/s)");
vg                      as Distribution1D(XDomain is l) of velocity                 (description:"Superficial Gas Velocity (m/s)");

cpg_mol_in              as hidden cp_mol                                            (description:"Inlet Gas Molar Specific Heat Capacity (kJ/kmol.K)");
cpgcsb(componentlist)   as hidden cp_mol                                            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Inlet Solids (Bottom) (kJ/kmol.K)");
cpgcst(componentlist)   as hidden cp_mol                                            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Inlet Solids (Top) (kJ/kmol.K)");
cbt                     as hidden Distribution1D(XDomain is l) of dens_mol          (description:"Bubble Region Gas Total Concentration (kmol/m^3)");
cct                     as hidden Distribution1D(XDomain is l) of dens_mol          (description:"Cloud-Wake Region Gas Total Concentration (kmol/m^3)");
cet                     as hidden Distribution1D(XDomain is l) of dens_mol          (description:"Emulsion Region Gas Total Concentration (kmol/m^3)");
cpg_mass                as hidden Distribution1D(XDomain is l) of cp_mass           (description:"Bubble Region Gas Mass Specific Heat Capacity (kJ/kg.K)");
cpg_mol                 as hidden Distribution1D(XDomain is l) of cp_mol            (description:"Bubble Region Gas Molar Specific Heat Capacity (kJ/kmol.K)");
cpgcgc(componentlist)   as hidden Distribution1D(XDomain is l) of cp_mol            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Cloud-Wake Region (Gas Temp) (kJ/kmol.K)");
cpgcge(componentlist)   as hidden Distribution1D(XDomain is l) of cp_mol            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Emulsion Region (Gas Temp) (kJ/kmol.K)");
cpgcsc(componentlist)   as hidden Distribution1D(XDomain is l) of cp_mol            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Cloud-Wake Region (Solid Temp) (kJ/kmol.K)");
cpgcse(componentlist)   as hidden Distribution1D(XDomain is l) of cp_mol            (description:"Gas Phase Pure Component Molar Specific Heat Capacities in Emulsion Region (Solid Temp) (kJ/kmol.K)");
D(componentlist)        as hidden Distribution1D(XDomain is l) of diffusivity       (description:"Component Gas Diffusivities (cm^2/s)");
kg                      as hidden Distribution1D(XDomain is l) of conductivity      (description:"Gas Thermal Conductivity (J/m.K.s)");
mug                     as hidden Distribution1D(XDomain is l) of notype            (description:"Gas Viscosity (kg/m.s)");
mugcp                   as hidden Distribution1D(XDomain is l) of viscosity         (description:"Gas Viscosity (cP)");
mw                      as hidden Distribution1D(XDomain is l) of molweight         (description:"Average Molecular Weight of Gas (kg/kmol)");
Pr                      as hidden Distribution1D(XDomain is l) of notype            (description:"Gas Prandtl Number");
rhog                    as hidden Distribution1D(XDomain is l) of dens_mass         (description:"Gas Density (kg/m^3)");

ap                      as area                                                     (description:"Particle Specific Surface Area (m^2/kg)");
cps                     as cp_mass                                                  (description:"Particle Heat Capacity (kJ/kg.K)");
dp                      as length                                                   (description:"Particle Diameter (m)");
dpd                     as notype                                                   (description:"Dimensionless Particle Size");
emf                     as fraction                                                 (description:"Bed Voidage at Minimum Fluidisation");
F                       as fraction                                                 (description:"Fines Fraction (<45 micron) of Solids");
geldart                 as notype                                                   (description:"Geldart Group Classification of Solid (A=1, B=2)");
kp                      as conductivity                                             (description:"Particle Conductivity (J/m.K.s)");
nv                      as notype                                                   (description:"Amine Loading of Sorbent (mol/m^3)");
phis                    as fraction                                                 (description:"Particle Sphericity");
rhos                    as dens_mass                                                (description:"Particle Density (kg/m^3)");
vgi                     as velocity                                                 (description:"Superficial Gas Velocity at Inlet Point (m/s)");
vcr                     as velocity                                                 (description:"Particle Critical Velocity (m/s)");
vmf                     as velocity                                                 (description:"Particle Minimum Fluidisation Velocity (m/s)");
vt                      as velocity                                                 (description:"Particle Terminal Velocity (m/s)");
vtr                     as velocity                                                 (description:"Particle Transport Velocity (m/s)");

eavg                    as fraction                                                 (description:"Overall Average Bed Voidage");
fw                      as notype                                                   (description:"Wake to Bubble Region Volume Ratio");
taus                    as timeSec                                                  (description:"Solids Residence Time (s)");
ed                      as Distribution1D(XDomain is l) of notype                   (description:"Voidage of Emulsion Region");
db                      as Distribution1D(XDomain is l) of length                   (description:"Bubble Diameter (m)");
Ar                      as hidden Distribution1D(XDomain is l) of notype            (description:"Particle Archimedes Number");
e                       as hidden Distribution1D(XDomain is l) of notype            (description:"Cross-Sectional Average Bed Voidage");
dbe                     as hidden Distribution1D(XDomain is l) of length            (description:"Equilibrium Bubble Diameter (m)");
dbm                     as hidden Distribution1D(XDomain is l) of length            (description:"Maximum Bubble Diameter via Coalescence (m)");
db0                     as hidden length                                            (description:"Initial Bubble Diameter (m)");
dbu                     as hidden Distribution1D(XDomain is l) of length            (description:"Unconstrained Bubble Diameter (m)");
delta                   as hidden Distribution1D(XDomain is l) of notype            (description:"Volume Fraction of Bubbles in Bed");
g1                      as hidden notype                                            (description:"Bubble Size Coefficient");
g2                      as hidden Distribution1D(XDomain is l) of notype            (description:"Bubble Size Coefficient");
g3                      as hidden Distribution1D(XDomain is l) of notype            (description:"Bubble Size Coefficient");
fc                      as hidden Distribution1d(Xdomain is l) of notype            (description:"Cloud to Bubble Region Volume Ratio");
fcw                     as hidden Distribution1d(Xdomain is l) of notype            (description:"Cloud-Wake to Bubble Region Volume Ratio");

K_d                     as notype                                                   (description:"Gas Phase Bulk Flow Coefficient (m^3/s)");
Hbc                     as hidden Distribution1D(XDomain is l) of notype            (description:"Bubble to Cloud-Wake Gas Heat Transfer Coefficient (kJ/m^3.K.s)");
Hce                     as hidden Distribution1D(XDomain is l) of notype            (description:"Cloud-Wake to Emulsion Gas Heat Transfer Coefficient (kJ/m^3.K.s)");
Hgbulk                  as hidden Distribution1D(XDomain is l) of notype            (description:"as Phase Bulk Flow Heat Transfer (kJ/s)");
Hsbulk                  as hidden Distribution1D(XDomain is l) of notype            (description:"Heat Trasnfer between Cloud-Wake and Emulsion Regions due to Bulk Solids Flow (kJ/s)");
hp                      as hidden Distribution1D(XDomain is l) of notype            (description:"Convective Heat Transfer Coefficient (kJ/m^2.K.s)");
Kbc(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Bubble to Cloud-Wake Gas Mass Transfer Coefficient (s^-1)");
Kce(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Cloud-Wake to Emulsion Gas Mass Transfer Coefficient (s^-1)");
Kcebs                   as hidden Distribution1D(XDomain is l) of notype            (description:"Cloud-Wake to Emulsion Solids Mass Transfer Coefficient (s^-1)");
Kgbulk(componentlist)   as hidden Distribution1D(XDomain is l) of notype            (description:"Gas Phase Bulk Flow Mass Transfer (kmol/s)");
Ksbulk(componentlist)   as hidden Distribution1D(XDomain is l) of notype            (description:"Bulk Flow of Adsorbed Species between Cloud-Wake and Emulsion Regions (mol/s)");
Nup                     as hidden Distribution1D(XDomain is l) of positive          (description:"Particle Nusselt Number");
Red                     as hidden Distribution1D(XDomain is l) of positive          (description:"Particle Reynolds Number in Emulsion Region");

A1                      as notype                                                   (description:"Arrhenius Constant for Water Physisorption (mol/m^3.Pa.K.s)");
A2                      as notype                                                   (description:"Arrhenius Constant for Bicarbonate Formation (1/Pa.K.s)");
A3                      as notype                                                   (description:"Arrhenius Constant for Carbamate Formation (1/Pa^m1.K.s)");
E1                      as notype                                                   (description:"Activation Energy for Water Physisorption (J/mol)");
E2                      as notype                                                   (description:"Activation Energy for Bicarbonate Formation (J/mol)");
E3                      as notype                                                   (description:"Activation Energy for Carbamate Formation (J/mol)");

dH1                     as notype                                                   (description:"Heat of Reaction for Water Physisorption (J/mol)");
dH2                     as notype                                                   (description:"Heat of Reaction for Bicarbonate Formation (J/mol)");
dH3                     as notype                                                   (description:"Heat of Reaction for Carbamate Formation (J/mol)");
dS1                     as notype                                                   (description:"Reaction Entropy for Water Physisorption (J/mol.K)");
dS2                     as notype                                                   (description:"Reaction Entropy for Bicarbonate Formation (J/mol.K)");
dS3                     as notype                                                   (description:"Reaction Entropy for Carbamate Formation (J/mol.K)");

m1                      as notype                                                   (description:"Non-Ideality Exponent for Carbamate Formation Reaction");

k1c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Water Physisorption in Cloud-Wake Region (mol/m^3.Pa.s)");
k2c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Bicarbonate Formation in Cloud-Wake Region (1/Pa.s)");
k3c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Carbamate Formation in Cloud-Wake Region (1/Pa^m1.s)");
k1e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Water Physisorption in Emulsion Region (mol/Pa.s)");
k2e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Bicarbonate Formation in Emulsion Region (1/Pa.s)");
k3e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate Constant for Carbamate Formation in Emulsion Region (1/Pa^m1.s)");

Ke1c                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Water Physisorption in Cloud-Wake Region (mol/m^3.Pa)");
Ke2c                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Bicarbonate Formation in Cloud-Wake Region (1/Pa)");
Ke3c                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Carbamate Formation in Cloud-Wake Region (Pa^-m1)");
Ke1e                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Water Physisorption in Emulsion Region (mol/m^3.Pa)");
Ke2e                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Bicarbonate Formation in Emulsion Region (1/Pa)");
Ke3e                    as hidden Distribution1D(XDomain is l) of notype            (description:"Equilibrium Constant for Carbamate Formation in Emulsion Region (Pa^-m1)");

rgc(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Cloud-Wake Region Gas Component Reaction Rates (kmol/m^3.s)");
rge(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Emulsion Region Gas Component Reaction Rates (kmol/m^3.s)");
rsc(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Cloud-Wake Region Adsorbed Species Reaction Rates (mol/m^3.s)");
rse(componentlist)      as hidden Distribution1D(XDomain is l) of notype            (description:"Emulsion Region Adsorbed Species Reaction Rates (mol/m^3.s)");
r1c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Water Physisorption in Cloud-Wake Region (mol/m^3.s)");
r2c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Bicarbonate Formation in Cloud-Wake Region (mol/m^3.s)");
r3c                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Carbamate Formation in Cloud-Wake Region (mol/mol amine.s)");
r1e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Water Physisorption in Emulsion Region (mol/m^3.s)");
r2e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Bicarbonate Formation in Emulsion Region (mol/m^3.s)");
r3e                     as hidden Distribution1D(XDomain is l) of notype            (description:"Rate of Carbamate Formation in Emulsion Region (mol/mol amine.s)");

dx                      as length                                                   (description:"Heat Exchanger Tube Diameter (m)");
lp                      as length                                                   (description:"Heat Exchanger Tube Pitch (m)");
lhx                     as length                                                   (description:"Heat Exchanger Tube Spacing, Pitch-Diameter (m)");
wthx                    as length                                                   (description:"Heat Exchanger Tube Wall Thickness (m)");
Nx                      as notype                                                   (description:"Heat Exchanger Number of Tubes");
dPhx                    as press_drop                                               (description:"Heat Exchanger Tube Pressure Drop (bar/m)");
mwhx                    as molweight                                                (description:"Heat Exchanger Fluid Molecular Weight (kg/kmol)");
vhx                     as velocity                                                 (description:"Heat Exchanger Fluid Velocity at Inlet (m/s)");
Thx                     as Distribution1D(XDomain is l) of temperature              (description:"Heat Exchanger Fluid Temperature (Celcius)");
Ttube                   as Distribution1D(XDomain is l) of temperature              (description:"Heat Exchanger Tube Wall Temperature (Celcius)");
hxvf                    as Distribution1D(XDomain is l) of vapfraction              (description:"Heat Exchanger Fluid Vapour Fraction)");
Phx                     as hidden Distribution1D(XDomain is l) of pressure          (description:"Heat Exchanger Fluid Pressure (bar)");
hxh                     as hidden Distribution1D(XDomain is l) of enth_mol          (description:"Heat Exchanger Fluid Specific Enthalpy (GJ/kmol)");
dThx                    as hidden Distribution1D(XDomain is l) of temp_diff         (description:"Heat Exchanger Temperature Difference (Celcius)");
rhohx                   as hidden Distribution1D(XDomain is l) of dens_mass         (description:"Heat Exchanger Fluid Density (kg/m^3)");
rhohxl                  as hidden Distribution1D(XDomain is l) of dens_mass         (description:"Heat Exchanger Fluid Liquid Phase Density (kg/m^3)");
rhohxv                  as hidden Distribution1D(XDomain is l) of dens_mass         (description:"Heat Exchanger Fluid Vapour Phase Density (kg/m^3)");
hxzv(componentlist)     as hidden Distribution1D(XDomain is l) of molefraction      (description:"Heat Exchanger Fluid Vapour Phase Composition");
hxzl(componentlist)     as hidden Distribution1D(XDomain is l) of molefraction      (description:"Heat Exchanger Fluid Liquid Phase Composition");
hxhv                    as hidden Distribution1D(XDomain is l) of enth_mol_vap      (description:"Heat Exchanger Fluid Vapour Phase Specific Enthalpy (GJ/kmol)");
hxhl                    as hidden Distribution1D(XDomain is l) of enth_mol_liq      (description:"Heat Exchanger Fluid Liquid Phase Specific Enthalpy (GJ/kmol)");

ah                      as notype                                                   (description:"Empirical Factor in Heat Transfer Model");
Cr                      as notype                                                   (description:"Average Correction Factor for Heat Exchanger Tubes");
hw                      as notype                                                   (description:"Heat Exchanger Tube Wall Heat Transfer Coefficient (kJ/m^2.K.s)");
Q                       as enthflow                                                 (description:"Total Heat Duty of Heat Exchanger Tubes (GJ/hr)");
fb                      as hidden Distribution1D(XDomain is l) of notype            (description:"Fraction of Time during which Heat Exchanger Contacts Emulsion Region");
fn                      as hidden Distribution1D(XDomain is l) of notype            (description:"Fluidisation Number (vg/vmf)");
hd                      as hidden Distribution1D(XDomain is l) of notype            (description:"Heat Transfer Coefficient due to Emulsion (kJ/m^2.K.s)");
hl                      as hidden Distribution1D(XDomain is l) of notype            (description:"Convective Heat Transfer Coefficient due to Bubbles (kJ/m^2.K.s)");
ht                      as hidden Distribution1D(XDomain is l) of notype            (description:"Overall Heat Transfer Coefficient (kJ/m^2.K.s)");
kpa                     as hidden Distribution1D(XDomain is l) of conductivity      (description:"onductivity of Bed at Minimum Fluidization (J/m.K.s)");
Nuh                     as hidden Distribution1D(XDomain is l) of notype            (description:"Convective Heat Exchange Nusselt Number");
tau                     as hidden Distribution1D(XDomain is l) of timeSec           (description:"Average Residence Time of Emulsion Packets at Heat Exchanger Surface (s)");

removalCO2              as notype                                                   (description:"CO2 Removal Fraction");
removalH2O              as notype                                                   (description:"H2O Removal Fraction");
regeneration            as notype                                                   (description:"Sorbent Regeneration Fraction");

Sit                     as hidden notype                                            (description:"Solids Flowrate through Top Inlet (kg/s)");
Sib                     as hidden notype                                            (description:"Solids Flowrate through Bottom Inlet (kg/s)");
Sot                     as hidden notype                                            (description:"Solids Flowrate through Top Outlet (kg/s)");
Sob                     as hidden notype                                            (description:"Solids Flowrate through Bottom Outlet (kg/s)");

Tref                    as temperature                                              (description:"Thermodynamic Reference Temperature (Celcius)");

IM(componentlist)(componentlist) as hidden molefraction                             (description:"Identiy Matrix");

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Declare Initialization Procedure Selectors

IPselectA               as IPselector                                               (description:"Bubble Region Material Balance IP Selector");
IPselectB               as IPselector                                               (description:"Hydrodynamics Model IP Selector");
IPselectC               as IPselector                                               (description:"Solids Material Balance IP Selector");
IPselectD               as IPselector                                               (description:"Emulsion Region Energy Balance IP Selector");
IPselectE               as IPselector                                               (description:"Cloud-Wake Region Energy Balance IP Selector");
IPselectF               as IPselector                                               (description:"Bubble Region Energy Balance IP Selector");
//IPselectZ             as IPselector                                               (description:"Next IP Selector");

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Declare Ports

GasIn                   as Input                                                    MainPort;
GasOut                  as Output                                                   MainPort;

HXIn                    as Input                                                    MainPort;
HXOut                   as Output                                                   MainPort;

SolidIn                 as Input                                                    SorbentPort;
SolidOut                as Output                                                   SorbentPort;

// The following block includes changes to solid ports in order to convert them to standard notation with other CCSI models
SorbIn_F                  as loading;
SorbIn_z(componentlist)   as molefraction;
SorbOut_F                 as loading;
SorbOut_z(componentlist)  as molefraction;
        
        SorbIn_F = Sigma(SolidIn.w);
        SorbIn_z("CO2") = SolidIn.w("Bic")/SorbIn_F;
        SorbIn_z("H2O") = SolidIn.w("H2O")/SorbIn_F;
        SorbIn_z("N2") = SolidIn.w("Car")/SorbIn_F;
        SorbOut_z("CO2") = SolidOut.w("Bic")/SorbOut_F;
        SorbOut_z("H2O") = SolidOut.w("H2O")/SorbOut_F;
        SorbOut_z("N2") = SolidOut.w("Car")/SorbOut_F;

// Heat Exchanger Fluid Inlet Variables
HXIn_zv(componentlist)  as hidden molefraction                                      (description:"Heat Exchanger Fluid Inlet Gas Composition");
HXIn_zl(componentlist)  as hidden molefraction                                      (description:"Heat Exchanger Fluid Inlet Liquid Composition");
HXIn_vf                 as hidden vapfraction                                       (description:"Heat Exchanger Fluid Inlet Vapour Fraction");
HXIn_hv                 as hidden enth_mol                                          (description:"Heat Exchanger Fluid Inlet Liquid Enthalpy");
HXIn_hl                 as hidden enth_mol                                          (description:"Heat Exchanger Fluid Inlet Vapour Enthalpy");

// =======================================================================================================================================================================================================
// Model Equations

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Reactor Sizing and Design

        // Superficial Gas Velocity at Inlet
        vgi = vg(0);

        // Total Bed Cross-Sectional Area Calculation
        vg*Ax*cbt*3600 = Gb;

        // Total Reactor Cross-Sectional Area Calculation (incl. Heat Exchangers)
        Areact = Ax + (pi/4)*(dx^2)*Nx;

        // Heat Exchanger Tube Pitch and Spacing - assumes square pitch
        Areact = Nx*(lp^2);
        lhx = lp - dx;

        // Cross-Sectional Area of Reactor - assumes circular cross-section
        Areact = pi*(Dt^2)/4;

        // Distributor Design
        100 = nor*Ao*100;

        // Discretisation Length
        dl = Lb/ND;

        // Surface Area of Heat Exchanger Tubes
        Ahx = pi*dx*Lb*Nx;

        // Calculating Equivalent Vessel Diameter (Kunii and Levenspiel 2nd Ed., pg. 150, Eqn. 6.13)
        Dte = 4*Ax/(pi*(Dt+dx*Nx));

        // Reactor Performance
        removalCO2      = 1 - GasOut.F*GasOut.z("CO2")/(GasIn.F*GasIn.z("CO2"));
        removalH2O      = 1 - GasOut.F*GasOut.z("H2O")/(GasIn.F*GasIn.z("H2O"));
        regeneration    = 1 - SolidOut.Fm*SorbOut_F*(1-SorbOut_z("H2O"))/(SolidIn.Fm*SorbIn_F*(1-SorbIn_z("H2O")));

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Mass and Energy Balances

        // Gas Phase Balances
        FOR i IN [l.Interior + l.EndNode] DO
          // Bubble Region Gas Component Balance
          0 = yb(componentlist)(i-1)*(Gb(i-1)/3600)*1E5 - yb(componentlist)(i)*(Gb(i)/3600)*1E5
                - dl*Ax*delta(i)*Kbc(componentlist)(i)*(cb(componentlist)(i) - cc(componentlist)(i))*1E5 + Kgbulk(componentlist)(i)*1E5;
          // Bubble Region Gas Energy Balance
          IF IPselectF == "Rigorous" THEN
            0 = (Gb(i-1)/3600)*cpg_mol(i-1)*(Tgb(i-1)-Tref) - (Gb(i)/3600)*cpg_mol(i)*(Tgb(i)-Tref) - dl*Ax*delta(i)*Hbc(i)*(Tgb(i)-Tgc(i)) + Hgbulk(i);
          ELSE
            Tgb(i) = GasIn.T;
          ENDIF        
        ENDFOR

        FOR i IN [0:l.EndNode] DO
          // Cloud-Wake Region Gas Component Balance
          0 = dl*Ax*delta(i)*Kbc(componentlist)(i)*(cb(componentlist)(i) - cc(componentlist)(i))*1E5 - dl*Ax*delta(i)*Kce(componentlist)(i)*(cc(componentlist)(i) - ce(componentlist)(i))*1E5
                - dl*Ax*fcw(i)*delta(i)*(1-ed(i))*rgc(componentlist)(i)*1E5;
          // Emulsion Region Gas Component Balance
          0 = dl*Ax*delta(i)*Kce(componentlist)(i)*(cc(componentlist)(i) - ce(componentlist)(i))*1E3 - dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*rge(componentlist)(i)*1E3
                - Kgbulk(componentlist)(i)*1E3;
          IF IPselectF == "Rigorous" THEN
            // Cloud-Wake Region Gas Energy Balance
            0 = dl*Ax*delta(i)*Hbc(i)*(Tgb(i)-Tgc(i)) - dl*Ax*delta(i)*Hce(i)*(Tgc(i)-Tge(i)) - dl*Ax*fcw(i)*delta(i)*(1-ed(i))*rhos*ap*hp(i)*(Tgc(i)-Tsc(i))
                  - dl*Ax*fcw(i)*delta(i)*(1-ed(i))*sigma(rgc(componentlist)(i)*cpgcgc(componentlist)(i))*(Tgc(i)-Tref);
            // Emulsion Region Gas Energy Balance
            0 = dl*Ax*delta(i)*Hce(i)*(Tgc(i)-Tge(i)) - dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*rhos*ap*hp(i)*(Tge(i)-Tse(i)) - Hgbulk(i)
                  - dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*sigma(rge(componentlist)(i)*cpgcge(componentlist)(i))*(Tge(i)-Tref);
          ELSE
            Tgc(i) = GasIn.T;
            Tge(i) = GasIn.T;
          ENDIF
        ENDFOR

        // Gas Phase Bulk Flow Transfer
        FOR i IN [0:l.EndNode] DO
          IF cet(i) > cbt(i) THEN
            Kgbulk(componentlist)(i)  = K_d*(cet(i) - cbt(i))*ye(componentlist)(i);
            Hgbulk(i)   = K_d*(cet(i) - cbt(i))*cpg_mol(i)*(Tge(i)-Tref);
          ELSE
            Kgbulk(componentlist)(i)  = K_d*(cet(i) - cbt(i))*yb(componentlist)(i);
            Hgbulk(i)   = K_d*(cet(i) - cbt(i))*cpg_mol(i)*(Tgb(i)-Tref);
          ENDIF
        ENDFOR

        FOR i IN [l.Interior] DO
          // Sorbent Balance
          Je(i) + Jc(i-1) = Je(i-1) + Jc(i);
          IF IPselectC == "Rigorous" THEN
            // Cloud-Wake Region Adsorbed Species Balances
            0 = (Jc(i-1)*nc(componentlist)(i-1) - Jc(i)*nc(componentlist)(i))*Ax - Ksbulk(componentlist)(i) - dl*Ax*delta(i)*rhos*Kcebs(i)*(nc(componentlist)(i)-ne(componentlist)(i))
                  + dl*Ax*fcw(i)*delta(i)*(1-ed(i))*rhos*rsc(componentlist)(i);
            // Emulsion Region Adsorbed Species Balances
            0 = (Je(i)*ne(componentlist)(i+1) - Je(i-1)*ne(componentlist)(i))*Ax + Ksbulk(componentlist)(i) + dl*Ax*delta(i)*rhos*Kcebs(i)*(nc(componentlist)(i)-ne(componentlist)(i))
                  + dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*rhos*rse(componentlist)(i);
          ELSE
            nc(componentlist,i) = SorbIn_F*SorbIn_z(componentlist)*rhos;
            ne(componentlist,i) = SorbIn_F*SorbIn_z(componentlist)*rhos;
          ENDIF
          IF IPselectE == "Rigorous" THEN
            // Cloud-Wake Region Solids Energy Balance
            0 = Jc(i-1)*Ax*hsc(i-1) - Jc(i)*Ax*hsc(i) - Hsbulk(i) - dl*Ax*delta(i)*rhos*Kcebs(i)*(hsc(i) - hse(i))
                + dl*Ax*fcw(i)*delta(i)*(1-ed(i))*sigma(rgc(componentlist)(i)*cpgcgc(componentlist)(i))*(Tgc(i)-Tref)
                  + dl*Ax*fcw(i)*delta(i)*(1-ed(i))*rhos*ap*hp(i)*(Tgc(i)-Tsc(i));
          ELSE
            Tsc(i) = SolidIn.T;
          ENDIF
          IF IPselectD == "Rigorous" THEN
            // Emulsion Region Solids Energy Balance
            0 = Je(i)*Ax*hse(i+1) - Je(i-1)*Ax*hse(i) + Hsbulk(i) + dl*Ax*delta(i)*rhos*Kcebs(i)*(hsc(i) - hse(i))
                  + dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*sigma(rge(componentlist)(i)*cpgcge(componentlist)(i))*(Tge(i)-Tref)
                    + dl*Ax*(1-fcw(i)*delta(i)-delta(i))*(1-ed(i))*rhos*ap*hp(i)*(Tge(i)-Tse(i)) + dl*pi*dx*ht(i)*dThx(i)*Nx*Cr;
          ELSE
            Tse(i) = Tsc(i);
          ENDIF
          // Solid Phase Bulk Flow Transfer
          IF Jc(i) < Jc(i-1) THEN
            Ksbulk(componentlist)(i) = -Ax*(Jc(i) - Jc(i-1))*nc(componentlist)(i);
            Hsbulk(i) = -Ax*(Jc(i) - Jc(i-1))*hsc(i);
          ELSE
            Ksbulk(componentlist)(i) = -Ax*(Jc(i) - Jc(i-1))*ne(componentlist)(i);
            Hsbulk(i) = -Ax*(Jc(i) - Jc(i-1))*hse(i);
          ENDIF
        ENDFOR

        FOR i IN [l.Interior + l.EndNode] DO
          // Pressure Drop Calculation
          (P(i) - P(i-1))*1E5 = -dl*(1-e(i))*rhos*gc;
        ENDFOR

        // Bubble Region Gas Flow Rate
        Gb/3600 = vb*Ax*delta*cbt;

        // Solids Flux Calculations
        Jc = fw*delta*rhos*(1-ed)*vb;
        Je = (1-fcw*delta-delta)*rhos*(1-ed)*us;

        // Gas Concentrations
        FOR i IN [0:l.EndNode] DO
          cb(componentlist)(i)*1E5 = yb(componentlist)(i)*cbt(i)*1E5;
          cc(componentlist)(i)*1E5 = yc(componentlist)(i)*cct(i)*1E5;
          ce(componentlist)(i)*1E5 = ye(componentlist)(i)*cet(i)*1E5;
          cet(i)*1E3 = sigma(ce(componentlist)(i))*1E3;
          cct(i)*1E3 = sigma(cc(componentlist)(i))*1E3;
        ENDFOR

        FOR i IN [l.Interior + l.EndNode] DO
          cbt(i)*1E3 = sigma(cb(componentlist)(i))*1E3;
        ENDFOR

        // Emulsion Solid Loading Calculations
        w_H2O*rhos = ne("H2O");
        w_Bic*rhos = ne("CO2");
        w_Car*rhos = ne("N2");
        w_t = w_H2O + w_Bic + w_Car;

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Gas Phase Properties using Aspen Properties

        // Inlet Gas Heat Capacity
        CALL (cpg_mol_in) = pCp_Mol_Vap (GasIn.T,P(0),GasIn.z(componentlist));

        FOR i IN [0:l.EndNode] DO
          // Gas Heat Capacity
          CALL (cpg_mol(i)) = pCp_Mol_Vap (Tgb(i),P(i),yb(componentlist)(i));
          // Bubble Phase Gas Total Concentration
          CALL (cbt(i)) = pDens_Mol_Vap (Tgb(i),P(i),yb(componentlist)(i));
          // Diffusion Coefficients
          CALL (D(componentlist)(i)) = pDiffus_Vap (Tge(i),P(i),ye(componentlist)(i));
          // Gas Thermal Conductivity
          CALL (kg(i)) = pCond_Vap (Tge(i),P(i),ye(componentlist)(i));
          // Gas Viscosity
          CALL (mugcp(i)) = pVisc_Vap (Tge(i),P(i),ye(componentlist)(i));
          // Gas Density Calculation
          CALL (rhog(i)) = pDens_Mass_Vap (Tge(i),P(i),ye(componentlist)(i));
          // Gas Phase Component Heat Capacities
          FOR j IN [componentlist] DO
            CALL (cpgcgc(j)(i)) = pCp_Mol_Vap (Tgc(i),P(i),IM(j));
            CALL (cpgcge(j)(i)) = pCp_Mol_Vap (Tge(i),P(i),IM(j));
            CALL (cpgcsc(j)(i)) = pCp_Mol_Vap (Tsc(i),P(i),IM(j));
            CALL (cpgcse(j)(i)) = pCp_Mol_Vap (Tse(i),P(i),IM(j));
          ENDFOR
          // Average Molecular Weight of Gas
          CALL (mw(i)) = pMolWeight (ye(componentlist)(i));
        ENDFOR

        // Converting Heat Capacities to Mass Basis
        cpg_mass = cpg_mol/mw;

        // Coverting Viscosity from cP to SI units
        mug*1E6 = mugcp/1000*1E6;

        // Create Identiy Matrix
        FOR i IN [componentlist] DO
          FOR j IN [componentlist] DO
            IF i == j THEN
              IM(i,j) = 1;
            ELSE
              IM(i,j) = 0;
            ENDIF
          ENDFOR
        ENDFOR

        // Gas Phase Component Heat Capacities for Calculating Inlet Sorbent Specific Enthalpy
        FOR j IN [componentlist] DO
          CALL (cpgcst(j)) = pCp_Mol_Vap (SolidIn.T,P(l.EndNode),IM(j));
          CALL (cpgcsb(j)) = pCp_Mol_Vap (SolidIn.T,P(0),IM(j));
        ENDFOR

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Fluidisation Conditions and Bubble Behaviour

        // Particle Archimedes Number
        Ar = (dp^3)*rhog*(rhos-rhog)*gc/(mug^2);

        // Cross-Sectional Average Voidage Calculation (K-L 2nd Ed., pg. 155, Eqn. 6.20)
        (1 - e) = (1 - ed)*(1-delta);

        // Overall Bed Voidage
        eavg = sigma(e)/ND;

        // Calculating Bubble Rise Velocity (K-L 2nd Ed., pg. 116, Eqn. 5.3)
        vbr*10 = 0.711*sqrt(gc*db)*10;

        // Unconstrained Bubble Diameter Calculations (Horio and Nonaka (1987))
        db0 = 1.38*(gc^(-0.2))*((vg(0)-ve(0))*Ao)^0.4;
        dbe = (Dt/4)*(-g1+g3)^2;
        dbm = 2.59*(gc^(-0.2))*((vg-ve)*Ax)^0.4;
        g1   = 2.56E-2*sqrt(Dt/gc)/vmf;
        g2 = Dt*((g1+g3)^2)/4;
        g3 = sqrt(g1^2+4*dbm/Dt);

        FOR i IN [0:l.EndNode] DO
          IF IPselectA == "Rigorous" THEN
            (((sqrt(dbu(i))-sqrt(dbe(i)))/(sqrt(db0)-sqrt(dbe(i))))^(1-g1/g3(i)))*(((sqrt(dbu(i))-sqrt(g2(i)))/(sqrt(db0)-sqrt(g2(i))))^(1+g1/g3(i))) = exp(-0.3*(i)*dl/(Dt));
            IF dbu(i) > Dte THEN
            // Bubble Constrained by Hydraulic Diameter
              db(i) = Dte;
            ELSE
            // Bubble Constrained by Growth
              db(i) = dbu(i);
            ENDIF
          ELSE
            dbu(i) = 0.1;
            // Initial Bubble Size Profile Guess
            db(i) = 0.03*dl*i + db0;
          ENDIF
        ENDFOR

        // Cloud to Bubble Region Volume Ratio (K-L 2nd Ed., pg. 120, Eqn. 5.8)
        fc = 3*(vmf/emf)/(vbr-(vmf/emf));

        // Cloud-Wake to Bubble Region Volume Ratio (K-L 2nd Ed., pg. 158, Eqn. 6.36)
        IF IPselectB == "Rigorous" THEN
          fcw = fc + fw;
          // Group A Solids
          IF geldart == 1 THEN
            // Bubble Velocity calculation based on whether bubbles are constrained by internals or not (K-L 2nd Ed, pg. 150)
            // This generally should not occur for Group A materials, but is included just in case.
            FOR i IN [0:l.EndNode] DO
              IF dbu(i) > Dte THEN
                // Bubble Velocity calculated by Slug Flow Velocity (K-L 2nd Ed., pg. 133, Eqn. 5.22
                vb(i) = (vg(i)-vmf)+0.35*sqrt(gc*Dte);
              ELSE
                // Bubble Velocity Calculation (Kunii and Levenspiel (1990), Eqn. 5)
                vb(i) = 1.55*((vg(i)-vmf)+14.1*(db(i)+0.005))*(Dte^0.32)+vbr(i);
              ENDIF
            ENDFOR
            // Emulsion Region Voidage (Abrahamsen and Geldart (1980))
            FOR i IN [0:l.EndNode] DO
              (1 - emf)*((dp^0.1)*(gc^0.118)*((rhos-rhog(i))^0.118)*((dl*(i+1))^0.043)) = 2.54*(rhog(i)^0.016)*(mug(i)^0.066)*exp(0.090*F)*(1-ed(i));
            ENDFOR
          // Group B Solids  
          ELSE
            // Bubble Velocity calculation based on whther bubbles are constrained by internals or not (K-L 2nd Ed, pg. 150)
            FOR i IN [0:l.EndNode] DO
              IF dbu(i) > Dte THEN
                // Bubble Velocity calculated by Slug Flow Velocity (K-L 2nd Ed., pg. 133, Eqn. 5.22)
                vb(i) = (vg(i)-vmf)+0.35*sqrt(gc*Dte);
              ELSE
                // Bubble Velocity Calculation (Kunii and Levenspiel (1990), Eqn. 6)
                vb(i) = 1.6*((vg(i)-vmf)+1.13*(db(i)^0.5))*(Dte^1.352)+vbr(i);
              ENDIF
            ENDFOR
              // Emulsion Region Voidage - assumed to be equal to minimum fluidization conditions for Group B materials
              ed = emf;
          ENDIF
        ELSE
          fcw = 0.27;
          delta = 0.1;
          ed = 0.55;
        ENDIF
        // Group A Solids
        IF geldart == 1 THEN
          // Emulsion Region Gas Velocity Calculation (Abrahamsen and Geldart (1980))
          FOR i IN [0:l.EndNode] DO
            ve(i)*((dp^0.568)*(gc^0.663)*((rhos-rhog(i))^0.663)*((dl*(i+1))^0.244)) = vmf*188*(rhog(i)^0.089)*(mug(i)^0.371)*exp(0.508*F);
          ENDFOR
        ELSE
          // Emulsion Region Gas Velocity Calculation
          3*(ve - vmf) = (vg-vmf);
        ENDIF

        // Solids Residence Time
        taus*SolidIn.Fm*1e-6 = Lb*Ax*(1-eavg)*rhos*3600*1e-6;

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// K-L Model Heat and Mass Transfer Coefficients

        IF IPselectB == "Rigorous" THEN
          FOR i IN [0:l.EndNode] DO
            // Bubble-Cloud Mass Transfer Coefficient (K-L 2nd Ed, pg. 251, Eqn. 10.27, with Sit and Grace Improvement Factor)
            Kbc(componentlist)(i) = 1.32*4.5*(vmf/db(i)) + 5.85*(((D(componentlist)(i)*1E-4)^0.5)*(gc^0.25)/(db(i)^(5/4)));
            // Cloud-Emulsion Mass Transfer Coefficients (K-L 2nd Ed., pg. 252, Eqn. 10.34)
            Kce(componentlist)(i)  = 6.77*sqrt(ed(i)*(D(componentlist)(i)*1E-4)*vbr(i)/(db(i)^3));
          ENDFOR
        ELSE
          Kbc = 1;
          Kce = 0.1;
        ENDIF

        // Solid Inter-Region Transfer Coefficient Calculation (K-L 2nd Ed, pg. 217, Eqn. 9.10)
        Kcebs = 3*(1-ed)/((1-delta)*ed)*(ve/db);

        // Bubble to Cloud-Wake Region Gas Heat Transfer Coefficient (K-L 2nd Ed., pg. 271, Eqn. 11.32, with Sit and Grace Improvement Factor)
        Hbc = 1.32*4.5*vmf*cbt*cpg_mol/db + 5.85*sqrt((kg/1000)*cbt*cpg_mol)*(gc^0.25)/(db^(5/4));

        // Cloud-Wake to Emulsion Region Gas Heat Transfer Coefficient (Based on K-L 2nd Ed., pg. 252, Eqn. 10.34 modified for heat transfer as per pg. 271)
        Hce = 6.78*sqrt(ed*vb*(kg/1000)*cct*cpg_mol/(db^3));

        // Convective Heat Transfer Coefficients
        Nup*1E4 = 1E4*1000*hp*dp/kg;

        // Particle Reynolds Number in Emulsion Region
        Red = ve*dp*rhog/mug;

        // Particle Nusselt Number in Emulsion Region (K-L 2nd Ed., pg. 269, Eqn. 11.27)
        Nup*1E4 = 0.03*(Red^1.3)*1E4;

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Heat Exchanger

        // Heat Exchanger Fluid Superficial Velocity at Inlet Point - Assumes 3 mm Tube Wall
        CALL (mwhx) = pMolWeight (HXIn.z);
        HXIn.F*mwhx*4*1e-3 = vhx*rhohx(l.EndNode)*pi*((dx-2*wthx)^2)*Nx*3600*1e-3;
        
        // Thermal Conductivity of Minimum Fluidized Bed (Chen et al., Eqn. 12)
        kpa = (3.58-2.5*ed)*kg*((kp/kg)^(0.46-0.46*ed));

        // Fluidization Number
        fn = vg/vmf;

        // Residence Time of Emulsion Packets at Heat Exchanger Surface (Baskakov et al., Eqn. 6)
        tau = 0.44*((dp*gc/((vmf^2)*((fn-ah)^2)))^0.14)*((dp/dx)^0.225);

        // Fraction of Time Heat Exchanger Surface is Exposed to Emulsion Packets (Baskakov et al., Eqn. 7)
        fb = 0.33*(((vmf^2)*((fn-ah)^2)/(dp*gc))^0.14);

        // Dense Region Heat Transfer Coefficient (Mickley and Fairbanks Equation from Chen et al., Eqn. 5)
        hd = 2*sqrt((kpa/1000)*rhos*cps*(1-ed)/(pi*tau));

        // Bubble Region Heat Transfer Coefficient (Baskakov et al., Eqn. 10)
        Pr = cpg_mass*1000*mug/kg;
        Nuh = 0.009*(Ar^0.5)*(Pr^0.33);
        Nuh = 1000*hl*dp/kg;

        // Total Heat Transfer Coefficient (Baskakov et al., Eqn. 8)
        ht = fb*hd + (1-fb)*hl;

        // Heat Exchanger Fluid Inlet Enthalpy
        Call(HXIn_zv,HXIn_zl,HXIn_vf,HXIn_hv,HXIn_hl) = pFlash(HXIn.T,HXIn.P,HXIn.z);
        HXIn.h = HXIn_hv*HXIn_vf + HXIn_hl*(1-HXIn_vf);

        // Heat Exchanger Fluid Pressure Drop
        Phx(l.EndNode) = HXIn.P;
        FOR i IN [0 + l.Interior] DO
                Phx(i+1) = Phx(i) + dl*dPhx + dl*rhohx(i+1)*1E-5;
        ENDFOR

        // Temperature Difference between Tubes and Bed
        dThx = Ttube - Tse;

        // Total Heat Transfer to Heat Exchanger
        Q = HXIn.F*(HXOut.h - HXIn.h);

        // Heat Transfer Fluid Inlet and Outlet Connections
        HXIn.F = HXOut.F;
        HXIn.z = HXOut.z;
        HXOut.T = Thx(0);
        HXOut.P = Phx(0);
        HXOut.h = hxh(0);

        // HX Tube Wall Energy Balance
        ht*dThx*Cr = hw*(Thx-Ttube);

        // Heat Exchanger Fluid Energy Balance
        FOR i IN [0 + l.Interior] DO
          0 = (HXIn.F/3600)*(hxh(i+1) - hxh(i)) - 1E-6*dl*pi*dx*ht(i)*dThx(i)*Nx*Cr;
        ENDFOR
        0 = (HXIn.F/3600)*(HXIn.h - hxh(l.EndNode)) - 1E-6*dl*pi*dx*ht(l.EndNode)*dThx(l.EndNode)*Nx*Cr;
        
        // Heat Exchanger Fluid Temperature (Flash Call)

        FOR i IN [0:l.EndNode] DO
          CALL (Thx(i),hxvf(i),hxzv(componentlist)(i),hxzl(componentlist)(i),hxhv(i),hxhl(i)) = pFlashPH (Phx(i),hxh(i),HXIn.z);
        ENDFOR

        // Calculating HX Fluid Mixture Density
        FOR i IN [0:l.EndNode] DO
          CALL (rhohxl(i)) = pDens_Mass_Liq (Thx(i), Phx(i), HXIn.z);
          CALL (rhohxv(i)) = pDens_Mass_Vap (Thx(i), Phx(i), HXIn.z);
        ENDFOR
        rhohx = rhohxv*hxvf + rhohxl*(1-hxvf);

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Particle Model

        // Calculated Particle Properties
        // Specific Surface Area of Particles
        ap = 6/(rhos*dp*phis);

        // Dimensionless Particle Diameter
        dpd = dp*(rhog(0)*(rhos-rhog(0))*gc/(mug(0)^2))^(1/3);

        // Geldart Group Classification, boundaries based on Grace (1986) from Yang (2007)
        IF Ar(0) < 1.03E6*((rhos-rhog(0))/rhog(0))^(-1.275) THEN
          geldart = 1;    // Group A Solid
        ELSE
          geldart = 2;    // Group B Solid
        ENDIF

        // Particle Hydrodynamic Velocities
        // Minimum Fluidisation Velocity (K-L 2nd Ed., pg. 69, Eqn. 3.18)
        10*1.75/(phis*emf^3)*(dp*vmf*rhog(0)/mug(0))^2 + 10*150*(1-emf)/(phis^2*emf^3)*(dp*vmf*rhog(0)/mug(0)) = 10*dp^3*rhog(0)*(rhos-rhog(0))*gc/mug(0)^2;

        // Particle Terminal Velocity (from K-L 2nd Ed., pg. 80, Eqns. 3.31, 3.32 and 3.33)
        10*vt*((rhog(l.EndNode)^2)/(mug(l.EndNode)*(rhos-rhog(l.EndNode))*gc))^(1/3) = 10*(18/(dpd^2) + (2.335-1.774*phis)/(sqrt(dpd)))^(-1);

        // Particle Critical Velocity (Bi et al., Table 2, Eqn j)
        0.936*(Ar(0)^0.472) = rhog(0)*vcr*dp/mug(0);

        // Particle Transport Velocity (Smoulders and Baeyens, Table 4, Eqn 8)
        0.169*(Ar(0)^0.545)*((Dt/dp)^0.3) = rhog(0)*vtr*dp/mug(0);

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Reaction Kinetics

        // Rate Constants
        k1c = A1*(Tsc+273.15)*exp(-E1/(R*(Tsc+273.15)));
        k2c = A2*(Tsc+273.15)*exp(-E2/(R*(Tsc+273.15)));
        k3c = A3*(Tsc+273.15)*exp(-E3/(R*(Tsc+273.15)));
        k1e = A1*(Tse+273.15)*exp(-E1/(R*(Tse+273.15)));
        k2e = A2*(Tse+273.15)*exp(-E2/(R*(Tse+273.15)));
        k3e = A3*(Tse+273.15)*exp(-E3/(R*(Tse+273.15)));

        // Equilibrium Constants
        Ke1c*P*1E5 = exp(-dH1/(R*(Tsc+273.15)) + dS1/R);
        Ke2c*P*1E5 = exp(-dH2/(R*(Tsc+273.15)) + dS2/R);
        Ke3c*P*1E5 = exp(-dH3/(R*(Tsc+273.15)) + dS3/R);
        Ke1e*P*1E5 = exp(-dH1/(R*(Tse+273.15)) + dS1/R);
        Ke2e*P*1E5 = exp(-dH2/(R*(Tse+273.15)) + dS2/R);
        Ke3e*P*1E5 = exp(-dH3/(R*(Tse+273.15)) + dS3/R);

        // Rate Equations for Individual Reactions
        r1c = k1c*((P*yc("H2O")*1E5) - (nc("H2O")/Ke1c));
        r2c = k2c*((1-2*(nc("N2")/nv)-(nc("CO2")/nv))*nc("H2O")*(P*yc("CO2")*1E5) - (((nc("N2")/nv)+(nc("CO2")/nv))*nc("CO2")/Ke2c));
        r3c = k3c*(((1-2*(nc("N2")/nv)-(nc("CO2")/nv))^2)*((P*yc("CO2")*1E5)^m1) - ((nc("N2")/nv)*((nc("N2")/nv)+(nc("CO2")/nv))/Ke3c));
        r1e = k1e*((P*ye("H2O")*1E5) - (ne("H2O")/Ke1e));
        r2e = k2e*((1-2*(ne("N2")/nv)-(ne("CO2")/nv))*ne("H2O")*(P*ye("CO2")*1E5) - (((ne("N2")/nv)+(ne("CO2")/nv))*ne("CO2")/Ke2e));
        r3e = k3e*(((1-2*(ne("N2")/nv)-(ne("CO2")/nv))^2)*((P*ye("CO2")*1E5)^m1) - ((ne("N2")/nv)*((ne("N2")/nv)+(ne("CO2")/nv))/Ke3e));

        // Reaction Rates for Mass Balances
        FOR j IN [componentlist] DO
          IF j == "CO2" THEN
            // Gaseous CO2 Consumption
            IF IPselectA == "Rigorous" THEN
              rgc(j)*1E3 = 1E3*(nv*r3c + r2c)/1000;
              rge(j)*1E4 = 1E4*(nv*r3e + r2e)/1000;
            ELSE
              rgc(j) = 0;
              rge(j) = 0;
            ENDIF
            // Formation of Bicarbonate
            rsc(j)*1E3 = r2c*1E3;
            rse(j)*1E3 = r2e*1E3;
          ELSEIF j == "H2O" THEN
            // Gaseous H2O Consumption
            IF IPselectA == "Rigorous" THEN
              rgc(j)*1E2 = 1E2*r1c/1000;
              rge(j)*1E3 = 1E3*r1e/1000;
            ELSE
              rgc(j) = 0;
              rge(j) = 0;
            ENDIF
            // Physisorption of Water
            rsc(j) = r1c - r2c;
            rse(j) = r1e - r2e;
          ELSEIF j == "N2" THEN
            // No Reaction of Inert Gases
            rgc(j) = 0;
            rge(j) = 0;
            // Formation of Carbamate
            rsc(j)*10 = nv*r3c*10;
            rse(j)*10 = nv*r3e*10;
          ELSE
            // Any Additional Species Uninvolved in Reactions
            rgc(j) = 0;
            rge(j) = 0;
            rsc(j) = 0;
            rse(j) = 0;
          ENDIF
        ENDFOR

        // Sorbent Specific Enthalpy - kJ/kg
        hsc = (1/rhos)*((nc("H2O")+nc("CO2"))*(cpgcsc("H2O")*(Tsc - Tref) + dH1) + nc("CO2")*(cpgcsc("CO2")*(Tsc - Tref) + dH2)
                + nc("N2")*(cpgcsc("CO2")*(Tsc - Tref) + dH3))*1E-3 + cps*(Tsc - Tref);
        hse = (1/rhos)*((ne("H2O")+ne("CO2"))*(cpgcse("H2O")*(Tse - Tref) + dH1) + ne("CO2")*(cpgcse("CO2")*(Tse - Tref) + dH2)
                + ne("N2")*(cpgcse("CO2")*(Tse - Tref) + dH3))*1E-3 + cps*(Tse - Tref);
        hsint = (1/rhos)*((nin("H2O")+nin("CO2"))*(cpgcst("H2O")*(SolidIn.T - Tref) + dH1) + nin("CO2")*(cpgcst("CO2")*(SolidIn.T - Tref) + dH2)
                  + nin("N2")*(cpgcst("CO2")*(SolidIn.T - Tref) + dH3))*1E-3 + cps*(SolidIn.T - Tref);
        hsinb = (1/rhos)*((nin("H2O")+nin("CO2"))*(cpgcsb("H2O")*(SolidIn.T - Tref) + dH1) + nin("CO2")*(cpgcsb("CO2")*(SolidIn.T - Tref) + dH2)
                  + nin("N2")*(cpgcsb("CO2")*(SolidIn.T - Tref) + dH3))*1E-3 + cps*(SolidIn.T - Tref);

// -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
// Boundary Conditions

        // Gas Inlet
        IF 0.2*(P(0) - P(l.EndNode)) > 0.034 THEN
          GasIn.P*1E2 = P(0)*1E2 + 0.2*(P(0) - P(l.EndNode))*1E2;
        ELSE
          GasIn.P*1E2 = P(0)*1E2 + 0.034*1E2;
        ENDIF
        Gb(0) = GasIn.F;
        IF IPselectF == "Rigorous" THEN
          0 = (GasIn.F/3600)*cpg_mol_in*(GasIn.T-Tref) - (Gb(0)/3600)*cpg_mol(0)*(Tgb(0)-Tref) - dl*Ax*delta(0)*Hbc(0)*(Tgb(0)-Tgc(0)) + Hgbulk(0);
        ELSE
          Tgb(0) = GasIn.T;
        ENDIF
        yb(componentlist)(0) = GasIn.z(componentlist);

        // Gas Outlet
        GasOut.P = P(l.EndNode);
        Gb(l.EndNode) = GasOut.F;
        GasOut.T = Tgb(l.EndNode);
        GasOut.z(componentlist) = yb(componentlist)(l.EndNode);

        // Solid Phase Boundary Conditions (Top and Bottom)
        // Inlet and Outlet Location
        IF SIType == "Top" THEN
          Sit = SolidIn.Fm/3600;
          Sib = 0;
        ELSE
          Sit = 0;
          Sib = SolidIn.Fm/3600;
        ENDIF
        IF SOType == "Overflow" THEN
          Sot = SolidOut.Fm/3600;
          Sob = 0;
        ELSE
          Sot = 0;
          Sob = SolidOut.Fm/3600;
        ENDIF

        // Solid Mass Balances
        Sib + Je(0)*Ax = Sob + Jc(0)*Ax;
        Sit + Jc(l.EndNode-1)*Ax = Sot + Je(l.EndNode-1)*Ax;
        Je(l.EndNode) = 0;

        // Adsorbed Species Mass Balances and Energy Balances
        0 = - Jc(0)*Ax*nc(componentlist)(0) - Ksbulk(componentlist)(0)
              - dl*Ax*delta(0)*rhos*Kcebs(0)*(nc(componentlist)(0)-ne(componentlist)(0))
                + dl*Ax*fcw(0)*delta(0)*(1-ed(0))*rhos*rsc(componentlist)(0);
        0 = Jc(l.EndNode-1)*Ax*nc(componentlist)(l.EndNode-1) - Ksbulk(componentlist)(l.EndNode)
              - dl*Ax*delta(l.EndNode)*rhos*Kcebs(l.EndNode)*(nc(componentlist)(l.EndNode)-ne(componentlist)(l.EndNode))
                + dl*Ax*fcw(l.EndNode)*delta(l.EndNode)*(1-ed(l.EndNode))*rhos*rsc(componentlist)(l.EndNode);
        0 = Sib*rhos*SorbIn_F*SorbIn_z(componentlist) - Sob*rhos*SorbOut_F*SorbOut_z(componentlist) + Je(0)*Ax*ne(componentlist)(1) + Ksbulk(componentlist)(0)
              + dl*Ax*delta(0)*rhos*Kcebs(0)*(nc(componentlist)(0)-ne(componentlist)(0))
                + dl*Ax*(1-fcw(0)*delta(0)-delta(0))*(1-ed(0))*rhos*rse(componentlist)(0);
        0 = Sit*rhos*SorbIn_F*SorbIn_z(componentlist) - Sot*rhos*SorbOut_F*SorbOut_z(componentlist) - Je(l.EndNode-1)*Ax*ne(componentlist)(l.EndNode) + Ksbulk(componentlist)(l.EndNode)
              + dl*Ax*delta(l.EndNode)*rhos*Kcebs(l.EndNode)*(nc(componentlist)(l.EndNode)-ne(componentlist)(l.EndNode))
                + dl*Ax*(1-fcw(l.EndNode)*delta(l.EndNode)-delta(l.EndNode))*(1-ed(l.EndNode))*rhos*rse(componentlist)(l.EndNode);
        IF IPselectE == "Rigorous" THEN
          0 = - Jc(0)*Ax*hsc(0) - Hsbulk(0) - dl*Ax*delta(0)*rhos*Kcebs(0)*(hsc(0) - hse(0))
                + dl*Ax*fcw(0)*delta(0)*(1-ed(0))*sigma(rgc(componentlist)(0)*cpgcgc(componentlist)(0))*(Tgc(0)-Tref)
                  + dl*Ax*fcw(0)*delta(0)*(1-ed(0))*rhos*ap*hp(0)*(Tgc(0)-Tsc(0));
          0 = Jc(l.EndNode-1)*Ax*hsc(l.EndNode-1) - Hsbulk(l.EndNode) - dl*Ax*delta(l.EndNode)*rhos*Kcebs(l.EndNode)*(hsc(l.EndNode) - hse(l.EndNode))
                + dl*Ax*fcw(l.EndNode)*delta(l.EndNode)*(1-ed(l.EndNode))*sigma(rgc(componentlist)(l.EndNode)*cpgcgc(componentlist)(l.EndNode))*(Tgc(l.EndNode)-Tref)
                  + dl*Ax*fcw(l.EndNode)*delta(l.EndNode)*(1-ed(l.EndNode))*rhos*ap*hp(l.EndNode)*(Tgc(l.EndNode)-Tsc(l.EndNode));
        ELSE
          Tsc(0) = SolidIn.T;
          Tsc(l.EndNode) = SolidIn.T;
        ENDIF
        IF IPselectD == "Rigorous" THEN
          0 = Sib*hsinb - Sob*hse(0) + Je(0)*Ax*hse(1) + Hsbulk(0) + dl*Ax*delta(0)*rhos*Kcebs(0)*(hsc(0) - hse(0))
                + dl*Ax*(1-fcw(0)*delta(0)-delta(0))*(1-ed(0))*sigma(rge(componentlist)(0)*cpgcge(componentlist)(0))*(Tge(0)-Tref)
                  + dl*Ax*(1-fcw(0)*delta(0)-delta(0))*(1-ed(0))*rhos*ap*hp(0)*(Tge(0)-Tse(0))
                    + dl*pi*dx*ht(0)*dThx(0)*Nx*Cr;
          0 = Sit*hsint - Sot*hse(l.EndNode) - Je(l.EndNode-1)*Ax*hse(l.EndNode) + Hsbulk(l.EndNode) + dl*Ax*delta(l.EndNode)*rhos*Kcebs(l.EndNode)*(hsc(l.EndNode) - hse(l.EndNode))
                + dl*Ax*(1-fcw(l.EndNode)*delta(l.EndNode)-delta(l.EndNode))*(1-ed(l.EndNode))*sigma(rge(componentlist)(l.EndNode)*cpgcge(componentlist)(l.EndNode))*(Tge(l.EndNode)-Tref)
                  + dl*Ax*(1-fcw(l.EndNode)*delta(l.EndNode)-delta(l.EndNode))*(1-ed(l.EndNode))*rhos*ap*hp(l.EndNode)*(Tge(l.EndNode)-Tse(l.EndNode))
                    + dl*pi*dx*ht(l.EndNode)*dThx(l.EndNode)*Nx*Cr;
        ELSE
          Tse(0) = Tsc(0);
          Tse(l.EndNode) = Tsc(l.EndNode);
        ENDIF
        
        // Solid Phase Bulk Flows at Boundaries
        Ksbulk(componentlist)(0) = -Ax*Jc(0)*ne(componentlist)(0);
        Ksbulk(componentlist)(l.EndNode) = Ax*Jc(l.EndNode-1)*nc(componentlist)(l.EndNode);
        Hsbulk(0) = -Ax*Jc(0)*hse(0);
        Hsbulk(l.EndNode) = Ax*Jc(l.EndNode-1)*hsc(l.EndNode);

        // Solid Outlet Conditions
        IF SOType == "Overflow" THEN
          SorbOut_F*rhos = sigma(ne(componentlist)(l.EndNode));
          SorbOut_z(componentlist)*SorbOut_F*rhos = ne(componentlist)(l.EndNode);
          SolidOut.T = Tse(l.EndNode);
        ELSE
          SorbOut_F*rhos = sigma(ne(componentlist)(0));
          SorbOut_z(componentlist)*SorbOut_F*rhos = ne(componentlist)(0);
          SolidOut.T = Tse(0);
        ENDIF

        // Solid Inlet Conditions
        nin(componentlist) = SorbIn_z(componentlist)*SorbIn_F*rhos;
        
// =======================================================================================================================================================================================================

//SYSTEM SECTION - WARNING: DO NOT EDIT
  Current_Icon : "System";
